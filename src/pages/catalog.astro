---
import Layout from '../layouts/Layout.astro';
import { properties } from '../data/properties';

const base = import.meta.env.BASE_URL;
---

<Layout showWhatsApp={true}>
	<header class="header">
		<div class="container nav-wrapper">
			<div class="logo">
				<a href={base}>
					<img src={`${base}/main-logo.png`} alt="Main Logo" height="80" />
				</a>
			</div>
			<button class="hamburger" id="hamburgerBtn" aria-label="Abrir menú">
				<span></span>
				<span></span>
				<span></span>
			</button>
			<nav class="nav" id="mainNav">
				<a href={base}>Inicio</a>
				<a href={`${base}/catalog?type=sale`}>Comprar</a>
				<a href={`${base}/catalog?type=rent`}>Alquilar</a>
				<a href={`${base}/#contacto`} class="btn-outline">Contacto</a>
			</nav>
		</div>
	</header>

	<main class="catalog-page">
		<section class="catalog-header">
			<div class="container">
				<h1>Nuestro Catálogo</h1>
				<p>Explora nuestra selección exclusiva de propiedades para comprar y alquilar.</p>
			</div>
		</section>

		<section class="catalog-content container">
			<button id="openFilters" class="btn-open-filters">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line></svg>
				Filtrar Propiedades
			</button>

			<aside class="filters-sidebar" id="filtersSidebar">
				<div class="sidebar-header-mobile">
					<h3>Filtros</h3>
					<button id="closeFilters" class="btn-close-filters">&times;</button>
				</div>

				<div class="filter-group">
					<h3>Ordenar por</h3>
					<select id="sortFilter">
						<option value="default">Relevancia</option>
						<option value="price_asc">Precio: Menor a Mayor</option>
						<option value="price_desc">Precio: Mayor a Menor</option>
					</select>
				</div>

				<div class="filter-group">
					<h3>Tipo de Operación</h3>
					<div class="radio-group">
						<label>
							<input type="radio" name="operationType" value="all" checked> Todos
						</label>
						<label>
							<input type="radio" name="operationType" value="sale"> Comprar
						</label>
						<label>
							<input type="radio" name="operationType" value="rent"> Alquilar
						</label>
					</div>
				</div>

				<div class="filter-group">
					<h3>Tipo de Propiedad</h3>
					<select id="propertyTypeFilter">
						<option value="all">Todos los tipos</option>
						<option value="Casa">Casa</option>
						<option value="Apartamento">Apartamento</option>
						<option value="Comercial">Comercial</option>
						<option value="Finca">Finca</option>
						<option value="Lote">Lote</option>
					</select>
				</div>

				<div class="filter-group">
					<h3>Estatus</h3>
					<select id="statusFilter">
						<option value="all">Cualquier estatus</option>
						<option value="invest">Inversión</option>
						<option value="presale">Preventa</option>
						<option value="available">Disponible</option>
					</select>
				</div>

				<div class="filter-group">
					<h3>Ubicación</h3>
					<select id="provinciaFilter">
						<option value="all">Todas las provincias</option>
					</select>
					<select id="cantonFilter" disabled>
						<option value="all">Todos los cantones</option>
					</select>
					<select id="distritoFilter" disabled>
						<option value="all">Todos los distritos</option>
					</select>
				</div>

				<div class="filter-group">
					<h3>Tamaño (m²)</h3>
					<div class="price-inputs">
						<input type="number" id="minArea" placeholder="Mín" min="0">
						<span>-</span>
						<input type="number" id="maxArea" placeholder="Máx" min="0">
					</div>
					<small class="price-note">Área en metros cuadrados</small>
				</div>

				<div class="filter-group">
					<h3>Filtro de Precio</h3>
					<div class="currency-selector">
						<label class="currency-radio">
							<input type="radio" name="currencyType" value="CRC" checked>
							<span class="radio-label">₡</span>
						</label>
						<label class="currency-radio">
							<input type="radio" name="currencyType" value="USD">
							<span class="radio-label">$</span>
						</label>
					</div>
					<div class="price-inputs">
						<input type="number" id="minPrice" placeholder="Mín" min="0">
						<span>-</span>
						<input type="number" id="maxPrice" placeholder="Máx" min="0">
					</div>
					<small id="priceRangeNote" class="price-note">Precios en colones costarricenses (₡)</small>
				</div>

				<div class="filter-group">
					<h3>Habitaciones (Mínimo)</h3>
					<div class="range-wrapper">
						<input type="range" id="bedsFilter" min="1" max="6" value="1" step="1">
						<span id="bedsValue">1+</span>
					</div>
				</div>

				<div class="filter-group">
					<h3>Baños (Mínimo)</h3>
					<div class="range-wrapper">
						<input type="range" id="bathsFilter" min="1" max="6" value="1" step="1">
						<span id="bathsValue">1+</span>
					</div>
				</div>

				<div class="filter-group">
					<h3>Parqueos (Mínimo)</h3>
					<div class="range-wrapper">
						<input type="range" id="parkingFilter" min="0" max="6" value="0" step="1">
						<span id="parkingValue">0+</span>
					</div>
				</div>

				<button id="applyFilters" class="btn-primary full-width mobile-only">Aplicar Filtros</button>
				<button id="resetFilters" class="btn-clear">Limpiar Filtros</button>
			</aside>

			<div class="properties-list">
				<div id="noResults" class="no-results hidden">
					<p>No se encontraron propiedades con los filtros seleccionados.</p>
				</div>
				<div class="property-grid" id="propertiesGrid">
					{properties.map(prop => (
						<a href={`${base}/propiedad/${prop.id}`}
							 class="property-card"
							 data-type={prop.type}
							 data-provincia={prop.provinciaId}
							 data-canton={prop.cantonId}
							 data-distrito={prop.distritoId}
							 data-beds={prop.beds}
							 data-baths={prop.baths}
							 data-parking={prop.parking}
							 data-area-val={prop.area.replace(/[^\d.]/g, '')}
							 data-price={prop.price}
							 data-price-usd={prop.priceUSD}
							 data-property-type={prop.propertyType}
							 data-status={prop.status}
						>
							<div class="card-image">
								<img src={prop.images[0]} alt={prop.title} loading="lazy" />
								<span class="badge">{prop.type === 'sale' ? 'Comprar' : 'Alquilar'}</span>
							</div>
							<div class="card-info">
								<h3 class="card-title">{prop.title}</h3>
								<p class="location">
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
									{prop.location}
								</p>
								<p class="price">{prop.priceDisplay} | <span class="price-usd">{prop.priceDisplayUSD}</span></p>

								<div class="card-specs">
									<div class="spec-main-row">
										<span class="spec-label">{prop.propertyType}</span>
										<span class="status-tag">{prop.status}</span>
									</div>
									<div class="spec-icons-row">
										{prop.beds > 0 && (
											<div class="spec-pill" title="Habitaciones">
												<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v11m0-4h18m0 4V8a3 3 0 0 0-3-3H6a3 3 0 0 0-3 3"/><path d="M7 11V7"/><path d="M17 11V7"/></svg>
												<span>{prop.beds}</span>
											</div>
										)}
										{prop.baths > 0 && (
											<div class="spec-pill" title="Baños">
												<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16a1 1 0 0 1 1 1v3a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4v-3a1 1 0 0 1 1-1z"/><path d="M6 12V5a2 2 0 0 1 2-2h3v2.25"/></svg>
												<span>{prop.baths}</span>
											</div>
										)}
										<div class="spec-pill" title="Área">
											<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 12h18"/><path d="M12 3v18"/></svg>
											<span>{prop.area.replace(' m²', '')}m²</span>
										</div>
										{prop.parking > 0 && (
											<div class="spec-pill" title="Parqueos">
												<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/></svg>
												<span>{prop.parking}</span>
											</div>
										)}
									</div>
								</div>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>
	</main>

	<footer class="footer">
		<div class="container footer-grid">
			<div class="footer-brand">
				<img src={`${base}/main-logo.png`} alt="Logo" height="80" />
			</div>
			<div class="footer-links">
				<h4>Navegación</h4>
				<a href={`${base}/catalog?type=sale`}>Comprar</a>
				<a href={`${base}/catalog?type=rent`}>Alquilar</a>
				<a href={`${base}/#contacto`}>Contacto</a>
			</div>
			<div class="footer-contact">
				<h4>Contacto</h4>
				<p>San José, Costa Rica</p>
				<p>+506 7014 1868</p>
			</div>
		</div>
		<div class="footer-bottom">
			<p>&copy; 2024 Real Estate. Todos los derechos reservados.</p>
		</div>
	</footer>
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const typeRadios = document.querySelectorAll('input[name="operationType"]');
		const provinciaSelect = document.getElementById('provinciaFilter') as HTMLSelectElement;
		const cantonSelect = document.getElementById('cantonFilter') as HTMLSelectElement;
		const distritoSelect = document.getElementById('distritoFilter') as HTMLSelectElement;
		const bedsInput = document.getElementById('bedsFilter') as HTMLInputElement;
		const bedsValue = document.getElementById('bedsValue');
		const bathsInput = document.getElementById('bathsFilter') as HTMLInputElement;
		const bathsValue = document.getElementById('bathsValue');
		const parkingInput = document.getElementById('parkingFilter') as HTMLInputElement;
		const parkingValue = document.getElementById('parkingValue');
		const resetBtn = document.getElementById('resetFilters');
		const grid = document.getElementById('propertiesGrid');
		const cards = document.querySelectorAll('.property-card');
		const noResults = document.getElementById('noResults');

		// Mobile Filter Logic
		const openFiltersBtn = document.getElementById('openFilters');
		const closeFiltersBtn = document.getElementById('closeFilters');
		const applyFiltersBtn = document.getElementById('applyFilters');
		const filtersSidebar = document.getElementById('filtersSidebar');

		if (openFiltersBtn) {
			openFiltersBtn.addEventListener('click', () => {
				filtersSidebar.classList.add('active');
				document.body.style.overflow = 'hidden';
			});
		}

		function closeFiltersPanel() {
			filtersSidebar.classList.remove('active');
			document.body.style.overflow = '';
		}

		if (closeFiltersBtn) {
			closeFiltersBtn.addEventListener('click', closeFiltersPanel);
		}

		if (applyFiltersBtn) {
			applyFiltersBtn.addEventListener('click', closeFiltersPanel);
		}

		// Hamburger menu
		const hamburgerBtn = document.getElementById('hamburgerBtn');
		const mainNav = document.getElementById('mainNav');

		hamburgerBtn.addEventListener('click', () => {
			hamburgerBtn.classList.toggle('active');
			mainNav.classList.toggle('active');
			document.body.style.overflow = mainNav.classList.contains('active') ? 'hidden' : '';
		});

		mainNav.querySelectorAll('a').forEach(link => {
			link.addEventListener('click', () => {
				hamburgerBtn.classList.remove('active');
				mainNav.classList.remove('active');
				document.body.style.overflow = '';
			});
		});

		// Close filters when clicking outside
		filtersSidebar.addEventListener('click', (e) => {
			if (e.target === filtersSidebar) {
				filtersSidebar.classList.remove('active');
				document.body.style.overflow = '';
			}
		});

		// --- Cascading Location Filters ---
		const API_BASE = 'https://ubicaciones.paginasweb.cr';

		async function loadProvincias() {
			try {
				const res = await fetch(`${API_BASE}/provincias.json`);
				const data = await res.json();
				Object.entries(data).forEach(([id, name]) => {
					const opt = document.createElement('option');
					opt.value = id;
					opt.textContent = name as string;
					provinciaSelect.appendChild(opt);
				});
			} catch (e) {
				console.error('Error loading provincias:', e);
			}
		}

		async function loadCantones(provinciaId: string) {
			cantonSelect.innerHTML = '<option value="all">Todos los cantones</option>';
			cantonSelect.disabled = true;
			distritoSelect.innerHTML = '<option value="all">Todos los distritos</option>';
			distritoSelect.disabled = true;
			if (provinciaId === 'all') return;
			try {
				const res = await fetch(`${API_BASE}/provincia/${provinciaId}/cantones.json`);
				const data = await res.json();
				Object.entries(data).forEach(([id, name]) => {
					const opt = document.createElement('option');
					opt.value = id;
					opt.textContent = name as string;
					cantonSelect.appendChild(opt);
				});
				cantonSelect.disabled = false;
			} catch (e) {
				console.error('Error loading cantones:', e);
			}
		}

		async function loadDistritos(provinciaId: string, cantonId: string) {
			distritoSelect.innerHTML = '<option value="all">Todos los distritos</option>';
			distritoSelect.disabled = true;
			if (cantonId === 'all') return;
			try {
				const res = await fetch(`${API_BASE}/provincia/${provinciaId}/canton/${cantonId}/distritos.json`);
				const data = await res.json();
				Object.entries(data).forEach(([id, name]) => {
					const opt = document.createElement('option');
					opt.value = id;
					opt.textContent = name as string;
					distritoSelect.appendChild(opt);
				});
				distritoSelect.disabled = false;
			} catch (e) {
				console.error('Error loading distritos:', e);
			}
		}

		provinciaSelect.addEventListener('change', async () => {
			await loadCantones(provinciaSelect.value);
			filterProperties();
		});

		cantonSelect.addEventListener('change', async () => {
			await loadDistritos(provinciaSelect.value, cantonSelect.value);
			filterProperties();
		});

		distritoSelect.addEventListener('change', () => {
			filterProperties();
		});

		// Load provincias on init
		loadProvincias();

		// Check URL params specifically for 'type'
		const urlParams = new URLSearchParams(window.location.search);
		const typeParam = urlParams.get('type');

		if (typeParam) {
			const radio = document.querySelector(`input[name="operationType"][value="${typeParam}"]`) as HTMLInputElement;
			if (radio) {
				radio.checked = true;
				filterProperties();
			}
		}

		function filterProperties() {
			const selectedType = (document.querySelector('input[name="operationType"]:checked') as HTMLInputElement).value;
			const selectedProvincia = provinciaSelect.value;
			const selectedCanton = cantonSelect.value;
			const selectedDistrito = distritoSelect.value;
			const selectedCategory = (document.getElementById('propertyTypeFilter') as HTMLSelectElement).value;
			const selectedStatus = (document.getElementById('statusFilter') as HTMLSelectElement).value;
			const selectedSort = (document.getElementById('sortFilter') as HTMLSelectElement).value;
			const minBeds = parseInt(bedsInput.value);
			const minBaths = parseInt(bathsInput.value);
			const minParking = parseInt(parkingInput.value);
			const minPrice = (document.getElementById('minPrice') as HTMLInputElement).value ? parseFloat((document.getElementById('minPrice') as HTMLInputElement).value) : 0;
			const maxPrice = (document.getElementById('maxPrice') as HTMLInputElement).value ? parseFloat((document.getElementById('maxPrice') as HTMLInputElement).value) : Infinity;
			const minArea = (document.getElementById('minArea') as HTMLInputElement).value ? parseFloat((document.getElementById('minArea') as HTMLInputElement).value) : 0;
			const maxArea = (document.getElementById('maxArea') as HTMLInputElement).value ? parseFloat((document.getElementById('maxArea') as HTMLInputElement).value) : Infinity;

			// Update values displayed next to ranges
			if (bedsValue) bedsValue.textContent = minBeds + "+";
			if (bathsValue) bathsValue.textContent = minBaths + "+";
			if (parkingValue) parkingValue.textContent = minParking + "+";

			const selectedCurrency = (document.querySelector('input[name="currencyType"]:checked') as HTMLInputElement).value;

			// Update note based on currency
			const priceNote = document.getElementById('priceRangeNote');
			if (priceNote) {
				if (selectedCurrency === 'USD') {
					priceNote.textContent = 'Precios en dólares estadounidenses ($)';
				} else {
					priceNote.textContent = 'Precios en colones costarricenses (₡)';
				}
			}

			// Filtering
			cards.forEach(card => {
				const cardType = card.getAttribute('data-type');
				const cardProvincia = card.getAttribute('data-provincia');
				const cardCanton = card.getAttribute('data-canton');
				const cardDistrito = card.getAttribute('data-distrito');
				const cardPropertyType = card.getAttribute('data-property-type');
				const cardStatus = card.getAttribute('data-status');
				const cardBeds = parseInt(card.getAttribute('data-beds') || '0');
				const cardBaths = parseInt(card.getAttribute('data-baths') || '0');
				const cardParking = parseInt(card.getAttribute('data-parking') || '0');
				const cardArea = parseFloat(card.getAttribute('data-area-val') || '0');
				const cardPrice = selectedCurrency === 'USD'
					? parseFloat(card.getAttribute('data-price-usd') || '0')
					: parseFloat(card.getAttribute('data-price') || '0');

				let show = true;

				// Filter by Type (Venta/Renta)
				if (selectedType !== 'all' && cardType !== selectedType) {
					show = false;
				}

				// Filter by Provincia
				if (selectedProvincia !== 'all' && cardProvincia !== selectedProvincia) {
					show = false;
				}

				// Filter by Canton
				if (selectedCanton !== 'all' && cardCanton !== selectedCanton) {
					show = false;
				}

				// Filter by Distrito
				if (selectedDistrito !== 'all' && cardDistrito !== selectedDistrito) {
					show = false;
				}

				// Filter by Property Type (lot/house)
				if (selectedCategory !== 'all' && cardPropertyType !== selectedCategory) {
					show = false;
				}

				// Filter by Status
				if (selectedStatus !== 'all' && cardStatus !== selectedStatus) {
					show = false;
				}

				// Filter by Beds
				if (cardBeds < minBeds) {
					show = false;
				}

				// Filter by Baths
				if (cardBaths < minBaths) {
					show = false;
				}

				// Filter by Parking
				if (cardParking < minParking) {
					show = false;
				}

				// Filter by Area
				if (cardArea < minArea || cardArea > maxArea) {
					show = false;
				}

				// Filter by Price
				if (cardPrice < minPrice || cardPrice > maxPrice) {
					show = false;
				}

				if (show) {
					(card as HTMLElement).style.display = 'block';
					card.classList.remove('hidden-card');
				} else {
					(card as HTMLElement).style.display = 'none';
					card.classList.add('hidden-card');
				}
			});

			// Sorting
			const visibleItems = Array.from(cards).filter(card => !card.classList.contains('hidden-card'));

			if (selectedSort === 'price_asc') {
				visibleItems.sort((a, b) => parseFloat(a.getAttribute('data-price')) - parseFloat(b.getAttribute('data-price')));
			} else if (selectedSort === 'price_desc') {
				visibleItems.sort((a, b) => parseFloat(b.getAttribute('data-price')) - parseFloat(a.getAttribute('data-price')));
			}

			// Re-append in correct order
			visibleItems.forEach(card => grid.appendChild(card));

			if (visibleItems.length === 0) {
				noResults.classList.remove('hidden');
			} else {
				noResults.classList.add('hidden');
			}
		}

		// Event Listeners
		typeRadios.forEach(radio => radio.addEventListener('change', filterProperties));
		document.getElementById('propertyTypeFilter').addEventListener('change', filterProperties);
		document.getElementById('statusFilter').addEventListener('change', filterProperties);
		document.getElementById('sortFilter').addEventListener('change', filterProperties);
		bedsInput.addEventListener('input', filterProperties);
		bathsInput.addEventListener('input', filterProperties);
		parkingInput.addEventListener('input', filterProperties);
		document.getElementById('minArea')?.addEventListener('input', filterProperties);
		document.getElementById('maxArea')?.addEventListener('input', filterProperties);
		document.getElementById('minPrice')?.addEventListener('input', filterProperties);
		document.getElementById('maxPrice').addEventListener('input', filterProperties);
		document.querySelectorAll('input[name="currencyType"]').forEach(radio => {
			radio.addEventListener('change', () => {
				const minInput = document.getElementById('minPrice');
				const maxInput = document.getElementById('maxPrice');
				if (minInput instanceof HTMLInputElement) minInput.value = '';
				if (maxInput instanceof HTMLInputElement) maxInput.value = '';
				filterProperties();
			});
		});

		resetBtn.addEventListener('click', () => {
			(document.querySelector('input[name="operationType"][value="all"]') as HTMLInputElement).checked = true;
			provinciaSelect.value = 'all';
			cantonSelect.innerHTML = '<option value="all">Todos los cantones</option>';
			cantonSelect.disabled = true;
			distritoSelect.innerHTML = '<option value="all">Todos los distritos</option>';
			distritoSelect.disabled = true;
			(document.getElementById('propertyTypeFilter') as HTMLSelectElement).value = 'all';
