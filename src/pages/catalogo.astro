---
import Layout from '../layouts/Layout.astro';
import { properties } from '../data/properties';

const base = import.meta.env.BASE_URL;
---

<Layout>
	<header class="header">
		<div class="container nav-wrapper">
			<div class="logo">
				<a href={base}>
					<img src={`${base}main-logo.png`} alt="Main Logo" height="50" />
				</a>
			</div>
			<button class="hamburger" id="hamburgerBtn" aria-label="Abrir menú">
				<span></span>
				<span></span>
				<span></span>
			</button>
			<nav class="nav" id="mainNav">
				<a href={base}>Inicio</a>
				<a href={`${base}catalogo?type=Venta`}>Venta</a>
				<a href={`${base}catalogo?type=Renta`}>Renta</a>
				<a href={`${base}#contacto`} class="btn-outline">Contacto</a>
			</nav>
		</div>
	</header>

	<main class="catalog-page">
		<section class="catalog-header">
			<div class="container">
				<h1>Nuestro Catálogo</h1>
				<p>Explora nuestra selección exclusiva de propiedades en venta y renta.</p>
			</div>
		</section>

		<section class="catalog-content container">
			<button id="openFilters" class="btn-open-filters">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line></svg>
				Filtrar Propiedades
			</button>

			<aside class="filters-sidebar" id="filtersSidebar">
				<div class="sidebar-header-mobile">
					<h3>Filtros</h3>
					<button id="closeFilters" class="btn-close-filters">&times;</button>
				</div>

				<div class="filter-group">
					<h3>Ordenar por</h3>
					<select id="sortFilter">
						<option value="default">Relevancia</option>
						<option value="price_asc">Precio: Menor a Mayor</option>
						<option value="price_desc">Precio: Mayor a Menor</option>
					</select>
				</div>
				
				<div class="filter-group">
					<h3>Tipo de Operación</h3>
					<div class="radio-group">
						<label>
							<input type="radio" name="operationType" value="all" checked> Todos
						</label>
						<label>
							<input type="radio" name="operationType" value="Venta"> Venta
						</label>
						<label>
							<input type="radio" name="operationType" value="Renta"> Renta
						</label>
					</div>
				</div>

				<div class="filter-group">
					<h3>Tipo de Propiedad</h3>
					<select id="propertyTypeFilter">
						<option value="all">Todos los tipos</option>
						<option value="Vivienda">Vivienda</option>
						<option value="Lote">Lote</option>
					</select>
				</div>
				
				<div class="filter-group">
					<h3>Estatus</h3>
					<select id="statusFilter">
						<option value="all">Cualquier estatus</option>
						<option value="Entrega Inmediata">Entrega Inmediata</option>
						<option value="Preventa">Preventa</option>
						<option value="Disponible">Disponible</option>
					</select>
				</div>

				<div class="filter-group">
					<h3>Ubicación</h3>
					<select id="locationFilter">
						<option value="all">Todas las ubicaciones</option>
						<option value="Escazú">Escazú</option>
						<option value="Santa Ana">Santa Ana</option>
						<option value="San José">San José</option>
						<option value="Guanacaste">Guanacaste</option>
						<option value="Heredia">Heredia</option>
						<option value="Alajuela">Alajuela</option>
					</select>
				</div>

				<div class="filter-group">
					<h3>Rango de Precio</h3>
					<div class="price-inputs">
						<input type="number" id="minPrice" placeholder="Mín" min="0">
						<span>-</span>
						<input type="number" id="maxPrice" placeholder="Máx" min="0">
					</div>
					<small class="price-note">Precios en colones costarricenses (₡)</small>
				</div>

				<div class="filter-group">
					<h3>Habitaciones (Mínimo)</h3>
					<div class="range-wrapper">
						<input type="range" id="bedsFilter" min="1" max="6" value="1" step="1">
						<span id="bedsValue">1+</span>
					</div>
				</div>

				<button id="applyFilters" class="btn-primary full-width mobile-only">Aplicar Filtros</button>
				<button id="resetFilters" class="btn-clear">Limpiar Filtros</button>
			</aside>
            
			<div class="properties-list">
				<div id="noResults" class="no-results hidden">
					<p>No se encontraron propiedades con los filtros seleccionados.</p>
				</div>
				<div class="property-grid" id="propertiesGrid">
					{properties.map(prop => (
						<div class="property-card" 
							 data-type={prop.type} 
							 data-location={prop.location} 
							 data-beds={prop.beds}
							 data-price={prop.price}
							 data-category={prop.category}
							 data-status={prop.status}
						>
							<div class="card-image">
								<img src={prop.images[0]} alt={prop.title} loading="lazy" />
								<span class="badge">{prop.type}</span>
							</div>
							<div class="card-info">
								<h3>{prop.title}</h3>
								<p class="location">{prop.location}</p>
								<p class="price">{prop.priceDisplay}</p>
								<div class="specs">
									<span>{prop.beds > 0 ? `${prop.beds} Hab` : 'Residencial'}</span>
									<span class="status-tag">{prop.status}</span>
								</div>
								<a href={`${base}propiedad/${prop.id}`} class="btn-details">Ver Detalles</a>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>
	</main>

	<footer class="footer">
		<div class="container footer-grid">
			<div class="footer-brand">
				<img src={`${base}main-logo.png`} alt="Logo" height="40" />
				<p>Excelencia en servicios inmobiliarios.</p>
			</div>
			<div class="footer-links">
				<h4>Navegación</h4>
				<a href={`${base}catalogo?type=Venta`}>Venta</a>
				<a href={`${base}catalogo?type=Renta`}>Renta</a>
				<a href={`${base}#contacto`}>Contacto</a>
			</div>
			<div class="footer-contact">
				<h4>Contacto</h4>
				<p>San José, Costa Rica</p>
				<p>+506 7014 1868</p>
			</div>
		</div>
		<div class="footer-bottom">
			<p>&copy; 2024 Real Estate. Todos los derechos reservados.</p>
		</div>
	</footer>
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const typeRadios = document.querySelectorAll('input[name="operationType"]');
		const locationSelect = document.getElementById('locationFilter');
		const bedsInput = document.getElementById('bedsFilter');
		const bedsValue = document.getElementById('bedsValue');
		const resetBtn = document.getElementById('resetFilters');
		const grid = document.getElementById('propertiesGrid');
		const cards = document.querySelectorAll('.property-card');
		const noResults = document.getElementById('noResults');

		// Mobile Filter Logic
		const openFiltersBtn = document.getElementById('openFilters');
		const closeFiltersBtn = document.getElementById('closeFilters');
		const applyFiltersBtn = document.getElementById('applyFilters');
		const filtersSidebar = document.getElementById('filtersSidebar');

		if (openFiltersBtn) {
			openFiltersBtn.addEventListener('click', () => {
				filtersSidebar.classList.add('active');
				document.body.style.overflow = 'hidden'; // Prevent background scrolling
			});
		}

		function closeFilters() {
			filtersSidebar.classList.remove('active');
			document.body.style.overflow = '';
		}

		if (closeFiltersBtn) {
			closeFiltersBtn.addEventListener('click', closeFilters);
		}

		if (applyFiltersBtn) {
			applyFiltersBtn.addEventListener('click', closeFilters);
		}

		// Hamburger menu
		const hamburgerBtn = document.getElementById('hamburgerBtn');
		const mainNav = document.getElementById('mainNav');

		hamburgerBtn.addEventListener('click', () => {
			hamburgerBtn.classList.toggle('active');
			mainNav.classList.toggle('active');
			document.body.style.overflow = mainNav.classList.contains('active') ? 'hidden' : '';
		});

		mainNav.querySelectorAll('a').forEach(link => {
			link.addEventListener('click', () => {
				hamburgerBtn.classList.remove('active');
				mainNav.classList.remove('active');
				document.body.style.overflow = '';
			});
		});

		// Close filters when clicking outside (optional, but good UX)
		filtersSidebar.addEventListener('click', (e) => {
			if (e.target === filtersSidebar) {
				filtersSidebar.classList.remove('active');
				document.body.style.overflow = '';
			}
		});

		// Check URL params specifically for 'type'
		const urlParams = new URLSearchParams(window.location.search);
		const typeParam = urlParams.get('type');
		
		if (typeParam) {
			const radio = document.querySelector(`input[name="operationType"][value="${typeParam}"]`);
			if (radio) {
				radio.checked = true;
				filterProperties();
			}
		}

		function filterProperties() {
			const selectedType = document.querySelector('input[name="operationType"]:checked').value;
			const selectedLocation = locationSelect.value;
			const selectedCategory = document.getElementById('propertyTypeFilter').value;
			const selectedStatus = document.getElementById('statusFilter').value;
			const selectedSort = document.getElementById('sortFilter').value;
			const minBeds = parseInt(bedsInput.value);
			const minPrice = document.getElementById('minPrice').value ? parseFloat(document.getElementById('minPrice').value) : 0;
			const maxPrice = document.getElementById('maxPrice').value ? parseFloat(document.getElementById('maxPrice').value) : Infinity;

			bedsValue.textContent = minBeds + "+";

			let visibleCards = [];
			cards.forEach(card => visibleCards.push({ card: card, element: card }));

			// Filtering
			cards.forEach(card => {
				const cardType = card.getAttribute('data-type');
				const cardLocation = card.getAttribute('data-location');
				const cardCategory = card.getAttribute('data-category');
				const cardStatus = card.getAttribute('data-status');
				const cardBeds = parseInt(card.getAttribute('data-beds'));
				const cardPrice = parseFloat(card.getAttribute('data-price'));
				
				let show = true;

				// Filter by Type (Venta/Renta)
				if (selectedType !== 'all' && cardType !== selectedType) {
					console.log('Filtered by Type', cardType, selectedType);
					show = false;
				}

				// Filter by Location
				if (selectedLocation !== 'all' && !cardLocation.includes(selectedLocation)) {
					show = false;
				}

				// Filter by Category (Lote/Vivienda)
				if (selectedCategory !== 'all' && cardCategory !== selectedCategory) {
					show = false;
				}

				// Filter by Status
				if (selectedStatus !== 'all' && cardStatus !== selectedStatus) {
					show = false;
				}

				// Filter by Beds 
				if (cardBeds < minBeds) {
					show = false;
				}

				// Filter by Price
				if (cardPrice < minPrice || cardPrice > maxPrice) {
					show = false;
				}

				if (show) {
					card.style.display = 'block';
					card.classList.remove('hidden-card');
				} else {
					card.style.display = 'none';
					card.classList.add('hidden-card');
				}
			});

			// Sorting
			const visibleItems = Array.from(cards).filter(card => !card.classList.contains('hidden-card'));
			
			if (selectedSort === 'price_asc') {
				visibleItems.sort((a, b) => parseFloat(a.getAttribute('data-price')) - parseFloat(b.getAttribute('data-price')));
			} else if (selectedSort === 'price_desc') {
				visibleItems.sort((a, b) => parseFloat(b.getAttribute('data-price')) - parseFloat(a.getAttribute('data-price')));
			}
			
			// Re-append in correct order
			visibleItems.forEach(card => grid.appendChild(card));


			if (visibleItems.length === 0) {
				noResults.classList.remove('hidden');
			} else {
				noResults.classList.add('hidden');
			}
		}

		// Event Listeners
		typeRadios.forEach(radio => radio.addEventListener('change', filterProperties));
		locationSelect.addEventListener('change', filterProperties);
		document.getElementById('propertyTypeFilter').addEventListener('change', filterProperties);
		document.getElementById('statusFilter').addEventListener('change', filterProperties);
		document.getElementById('sortFilter').addEventListener('change', filterProperties);
		bedsInput.addEventListener('input', filterProperties);
		document.getElementById('minPrice').addEventListener('input', filterProperties);
		document.getElementById('maxPrice').addEventListener('input', filterProperties);
		
		resetBtn.addEventListener('click', () => {
			document.querySelector('input[name="operationType"][value="all"]').checked = true;
			locationSelect.value = 'all';
			document.getElementById('propertyTypeFilter').value = 'all';
			document.getElementById('statusFilter').value = 'all';
			document.getElementById('sortFilter').value = 'default';
			bedsInput.value = '1';
			document.getElementById('minPrice').value = '';
			document.getElementById('maxPrice').value = '';
			filterProperties();
		});

		// Initial filter maybe run once? usually not needed unless url params
	});
</script>

<style>
	/* Reuse and extend global styles */
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.header {
		position: sticky;
		top: 0;
		width: 100%;
		z-index: 100;
		padding: 1rem 0;
		background: rgba(255, 255, 255, 0.98);
		border-bottom: 1px solid rgba(0,0,0,0.08);
		backdrop-filter: blur(10px);
	}

	.nav-wrapper {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.nav {
		display: flex;
		gap: 2rem;
		align-items: center;
		font-weight: 500;
		text-transform: uppercase;
		font-size: 0.85rem;
		letter-spacing: 1px;
	}

	.nav a {
		color: var(--primary);
	}

	.nav a:hover {
		color: var(--accent);
	}

	.btn-outline {
		padding: 0.5rem 1.2rem;
		border: 1px solid var(--primary);
		transition: all 0.3s;
	}

	.btn-outline:hover {
		background: var(--primary);
		color: var(--white) !important;
	}

	/* Catalog Specific Styles */
	.catalog-page {
		min-height: 80vh;
		padding-bottom: 5rem;
	}

	.catalog-header {
		background-color: var(--secondary);
		padding: 4rem 0;
		text-align: center;
		margin-bottom: 3rem;
	}

	.catalog-header h1 {
		font-size: 3rem;
		margin-bottom: 1rem;
	}

	.catalog-header p {
		color: var(--text-muted);
		max-width: 600px;
		margin: 0 auto;
	}

	.catalog-content {
		display: grid;
		grid-template-columns: 250px 1fr;
		gap: 3rem;
	}

	/* Sidebar Filters */
	.filters-sidebar {
		background: #fff;
		padding: 2rem;
		border: 1px solid #eee;
		border-radius: 8px;
		height: fit-content;
		position: sticky;
		top: 100px;
	}

	.filter-group {
		margin-bottom: 2rem;
	}

	.filter-group h3 {
		font-size: 1.1rem;
		margin-bottom: 1rem;
		border-bottom: 2px solid var(--accent);
		padding-bottom: 0.5rem;
		display: inline-block;
	}

	.radio-group {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}

	.radio-group label {
		cursor: pointer;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.95rem;
	}

	select {
		width: 100%;
		padding: 0.8rem;
		border: 1px solid #ddd;
		border-radius: 4px;
		background: #fff;
		font-family: inherit;
		color: var(--text-main);
	}

	.range-wrapper {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	input[type="range"] {
		flex: 1;
		accent-color: var(--accent);
	}

	.btn-clear {
		width: 100%;
		padding: 0.8rem;
		background: transparent;
		border: 1px dashed var(--text-muted);
		color: var(--text-muted);
		cursor: pointer;
		transition: all 0.3s;
	}

	.btn-clear:hover {
		border-color: var(--primary);
		color: var(--primary);
	}

	.price-inputs {
		display: flex;
		gap: 0.5rem;
		align-items: center;
	}

	.price-inputs input {
		width: 100%;
		padding: 0.6rem;
		border: 1px solid #ddd;
		border-radius: 4px;
	}

	.full-width {
		width: 100%;
		margin-bottom: 1rem;
	}

	.btn-primary {
		display: inline-block;
		background: var(--primary);
		color: var(--white);
		padding: 1rem 1.5rem;
		border: none;
		border-radius: 4px;
		font-family: inherit;
		font-weight: 600;
		font-size: 1rem;
		cursor: pointer;
		text-align: center;
		transition: all 0.3s;
		box-shadow: 0 4px 6px rgba(0,0,0,0.1);
	}

	.btn-primary:hover {
		background: #333;
		transform: translateY(-2px);
		box-shadow: 0 6px 12px rgba(0,0,0,0.15);
	}

	.mobile-only {
		display: none;
	}

	/* Property Grid */
	.properties-list {
		margin-top: -10px; /* Align top with sidebar */
	}

	.property-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 2rem;
	}

	.property-card {
		background: #fff;
		border: 1px solid #eee;
		border-radius: 8px;
		overflow: hidden;
		transition: transform 0.3s, box-shadow 0.3s;
	}

	.property-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 10px 20px rgba(0,0,0,0.05);
	}

	.card-image {
		height: 220px;
		position: relative;
		overflow: hidden;
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s;
	}

	.property-card:hover .card-image img {
		transform: scale(1.05);
	}

	.badge {
		position: absolute;
		top: 1rem;
		right: 1rem;
		background: var(--accent);
		color: #fff;
		padding: 0.3rem 0.8rem;
		font-size: 0.75rem;
		font-weight: 600;
		border-radius: 2px;
	}

	.card-info {
		padding: 1.5rem;
	}

	.card-info h3 {
		font-size: 1.2rem;
		margin-bottom: 0.5rem;
		line-height: 1.3;
	}

	.location {
		color: var(--text-muted);
		font-size: 0.9rem;
		margin-bottom: 1rem;
	}

	.price {
		color: var(--primary);
		font-weight: 700;
		font-size: 1.1rem;
		margin-bottom: 1rem;
	}

	.specs {
		display: flex;
		gap: 1rem;
		font-size: 0.85rem;
		color: var(--text-muted);
		border-top: 1px solid #f0f0f0;
		padding-top: 1rem;
		margin-bottom: 1rem;
	}

	.btn-details {
		display: block;
		width: 100%;
		padding: 0.8rem;
		background: var(--primary);
		color: var(--white);
		border: none;
		font-family: inherit;
		font-weight: 500;
		cursor: pointer;
		transition: background 0.3s;
		text-align: center;
		text-decoration: none;
	}

	.btn-details:hover {
		background: #333;
	}

	.no-results {
		text-align: center;
		padding: 3rem;
		background: #f9f9f9;
		border-radius: 8px;
		color: var(--text-muted);
		font-size: 1.1rem;
	}

	.hidden {
		display: none;
	}

	/* Footer styles (reused) */
	.footer {
		padding: 4rem 0 2rem;
		border-top: 1px solid #eee;
		background: #fff;
		margin-top: auto;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 3rem;
		margin-bottom: 3rem;
	}

	.footer-brand p {
		margin-top: 1rem;
		color: var(--text-muted);
		max-width: 250px;
	}

	.footer h4 {
		margin-bottom: 1.2rem;
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.footer-links a, .footer-contact p {
		display: block;
		margin-bottom: 0.7rem;
		color: var(--text-muted);
	}

	.footer-links a:hover {
		color: var(--accent);
	}

	.footer-bottom {
		text-align: center;
		padding-top: 2rem;
		border-top: 1px solid #f5f5f5;
		color: var(--text-muted);
		font-size: 0.85rem;
	}

	/* Mobile Filters Button */
	.btn-open-filters {
		display: none;
		align-items: center;
		gap: 0.5rem;
		width: 100%;
		padding: 1rem;
		background: #fff;
		border: 1px solid #ddd;
		border-radius: 8px;
		font-family: inherit;
		font-weight: 600;
		font-size: 1rem;
		color: var(--primary);
		margin-bottom: 2rem;
		cursor: pointer;
		justify-content: center;
		transition: all 0.3s;
	}

	.btn-open-filters:hover {
		background: #f9f9f9;
		border-color: var(--primary);
	}

	.sidebar-header-mobile {
		display: none;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid #eee;
	}

	.btn-close-filters {
		background: none;
		border: none;
		font-size: 2rem;
		line-height: 1;
		cursor: pointer;
		color: var(--text-main);
	}

	/* Hamburger button */
	.hamburger {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
