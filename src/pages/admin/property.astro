---
const { env } = Astro.locals.runtime;
const id = Astro.url.searchParams.get('id');
let property: any = null;

if (id) {
	const row: any = await env.DB.prepare('SELECT * FROM properties WHERE id = ?').bind(id).first();
	if (row) {
		property = {
			...row,
			images: JSON.parse(row.images || '[]'),
		};
	}
}

const isEdit = !!property;
const title = isEdit ? `Editar: ${property.title}` : 'Nueva Propiedad';
---

<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{title} - Admin SCR Propiedades</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
	<header class="admin-header">
		<div class="header-inner">
			<h1>SCR Propiedades - Admin</h1>
			<a href="/admin" class="btn-link">&larr; Volver al listado</a>
		</div>
	</header>

	<main class="admin-main">
		<h2>{title}</h2>

		<form id="propertyForm" class="property-form">
			<input type="hidden" id="propertyId" value={property?.id || ''} />

			<div class="form-grid">
				<div class="form-section">
					<h3>Información General</h3>

					{property?.code && (
						<div class="field">
							<label>Código</label>
							<input type="text" value={property.code} disabled class="field-code" />
						</div>
					)}

					<div class="field">
						<label for="title">Título *</label>
						<input type="text" id="title" name="title" required value={property?.title || ''} />
					</div>

					<div class="field-row">
						<div class="field">
							<label for="type">Operación *</label>
							<select id="type" name="type" required>
								<option value="sale" selected={property?.type === 'sale'}>Venta</option>
								<option value="rent" selected={property?.type === 'rent'}>Alquiler</option>
							</select>
						</div>
						<div class="field">
							<label for="property_type">Tipo de Propiedad *</label>
							<select id="property_type" name="property_type" required>
								<option value="Casa" selected={property?.property_type === 'Casa'}>Casa</option>
								<option value="Apartamento" selected={property?.property_type === 'Apartamento'}>Apartamento</option>
								<option value="Comercial" selected={property?.property_type === 'Comercial'}>Comercial</option>
								<option value="Finca" selected={property?.property_type === 'Finca'}>Finca</option>
								<option value="Lote" selected={property?.property_type === 'Lote'}>Lote</option>
							</select>
						</div>
						<div class="field">
							<label for="status">Estado</label>
							<select id="status" name="status">
								<option value="available" selected={property?.status === 'available'}>Disponible</option>
								<option value="presale" selected={property?.status === 'presale'}>Preventa</option>
								<option value="investment" selected={property?.status === 'investment'}>Inversión</option>
								<option value="sold" selected={property?.status === 'sold'}>Vendido</option>
								<option value="rented" selected={property?.status === 'rented'}>Alquilado</option>
							</select>
						</div>
					</div>
				</div>

				<div class="form-section">
					<h3>Precios</h3>
					<div class="field-row">
						<div class="field">
							<label for="price">Precio (₡)</label>
							<input type="number" id="price" name="price" value={property?.price || ''} />
						</div>
						<div class="field">
							<label for="price_display">Precio Mostrado (₡)</label>
							<input type="text" id="price_display" name="price_display" value={property?.price_display || ''} placeholder="₡620,000,000" />
						</div>
					</div>
					<div class="field-row">
						<div class="field">
							<label for="price_usd">Precio (USD)</label>
							<input type="number" id="price_usd" name="price_usd" value={property?.price_usd || ''} />
						</div>
						<div class="field">
							<label for="price_display_usd">Precio Mostrado (USD)</label>
							<input type="text" id="price_display_usd" name="price_display_usd" value={property?.price_display_usd || ''} placeholder="$1,215,686" />
						</div>
					</div>
				</div>

				<div class="form-section">
					<h3>Ubicación</h3>
					<div class="field">
						<label for="location">Ubicación *</label>
						<input type="text" id="location" name="location" required value={property?.location || ''} placeholder="Escazú, San José" />
					</div>
					<div class="field-row">
						<div class="field">
							<label for="provincia_id">Provincia</label>
							<select id="provincia_id" name="provincia_id" data-initial={property?.provincia_id || ''}>
								<option value="">Seleccionar provincia</option>
							</select>
						</div>
						<div class="field">
							<label for="canton_id">Cantón</label>
							<select id="canton_id" name="canton_id" disabled data-initial={property?.canton_id || ''}>
								<option value="">Seleccionar cantón</option>
							</select>
						</div>
						<div class="field">
							<label for="distrito_id">Distrito</label>
							<select id="distrito_id" name="distrito_id" disabled data-initial={property?.distrito_id || ''}>
								<option value="">Seleccionar distrito</option>
							</select>
						</div>
					</div>
					<div class="field-row">
						<div class="field">
							<label for="lat">Latitud</label>
							<input type="number" id="lat" name="lat" step="any" value={property?.lat || ''} />
						</div>
						<div class="field">
							<label for="lng">Longitud</label>
							<input type="number" id="lng" name="lng" step="any" value={property?.lng || ''} />
						</div>
					</div>
				</div>

				<div class="form-section">
					<h3>Características</h3>
					<p id="charNote" class="char-note">Habitaciones, Baños y Parqueos son obligatorios para <strong>Casa</strong> y <strong>Apartamento</strong>. No aplican para Lote, Finca y Comercial.</p>
					<div class="field-row">
						<div class="field" id="bedsField">
							<label for="beds" id="bedsLabel">Habitaciones</label>
							<input type="number" id="beds" name="beds" min="0" value={property?.beds ?? 0} />
							<span id="bedsWarn" class="field-warn hidden">Requerido para este tipo de propiedad</span>
						</div>
						<div class="field" id="bathsField">
							<label for="baths" id="bathsLabel">Baños</label>
							<input type="number" id="baths" name="baths" min="0" step="0.5" value={property?.baths ?? 0} />
							<span id="bathsWarn" class="field-warn hidden">Requerido para este tipo de propiedad</span>
						</div>
						<div class="field">
							<label for="area">Área *</label>
							<input type="text" id="area" name="area" required value={property?.area || ''} placeholder="350 m²" />
						</div>
						<div class="field" id="parkingField">
							<label for="parking" id="parkingLabel">Parqueos</label>
							<input type="number" id="parking" name="parking" min="0" value={property?.parking ?? 0} />
							<span id="parkingWarn" class="field-warn hidden">Requerido para este tipo de propiedad</span>
						</div>
					</div>
				</div>

				<div class="form-section">
					<h3>Descripción</h3>
					<div class="field">
						<label for="description">Descripción</label>
						<textarea id="description" name="description" rows="5">{property?.description || ''}</textarea>
					</div>
				</div>

				<div class="form-section">
					<h3>Notas internas</h3>
					<textarea id="notes" name="notes" class="notes-hidden">{property?.notes || ''}</textarea>
					<div id="notesList" class="notes-list"></div>
					<div class="notes-input-row">
						<input type="text" id="noteInput" class="notes-new-input" placeholder="Escribe una nota..." />
						<button type="button" id="addNoteRow" class="notes-save-btn">Agregar</button>
					</div>
					<div class="notes-actions">
						<button type="button" id="saveNotesBtn" class="btn-primary notes-submit-btn">
							{isEdit ? 'Guardar Cambios' : 'Crear Propiedad'}
						</button>
					</div>
				</div>

				<div class="form-section">
					<h3>Imágenes</h3>
					<div class="field">
						<label>Subir imágenes</label>
						<div class="upload-area" id="uploadArea">
							<input type="file" id="fileInput" multiple accept="image/*" />
							<p>Arrastre imágenes aquí o haga clic para seleccionar (max 1600px)</p>
						</div>
						<div id="uploadProgress" class="upload-progress hidden"></div>
					</div>
					<div class="field">
						<label>Imágenes actuales</label>
						<p class="drag-hint">Arrastre para reordenar. La primera imagen será la portada.</p>
						<div id="imagesList" class="images-list">
							{(property?.images || []).map((url: string, i: number) => (
								<div class="image-item" data-url={url} draggable="true">
									<span class="drag-handle">⠿</span>
									<img src={url} alt={`Imagen ${i + 1}`} />
									<button type="button" class="btn-remove-img" title="Eliminar">&times;</button>
								</div>
							))}
						</div>
						<div class="field" style="margin-top: 0.5rem;">
							<label for="manualImageUrl">Agregar URL de imagen</label>
							<div class="url-input-row">
								<input type="text" id="manualImageUrl" placeholder="https://..." />
								<button type="button" id="addUrlBtn" class="btn-sm btn-add-url">Agregar</button>
							</div>
						</div>
					</div>
				</div>

				<div class="form-section">
					<h3>Contacto y Redes</h3>
					<div class="field-row">
						<div class="field">
							<label for="contact_number">Número de Contacto</label>
							<input type="text" id="contact_number" name="contact_number" value={property?.contact_number || '50670141868'} />
						</div>
						<div class="field">
							<label for="instagram">Instagram</label>
							<input type="url" id="instagram" name="instagram" value={property?.instagram || ''} />
						</div>
						<div class="field">
							<label for="video">Video</label>
							<input type="url" id="video" name="video" value={property?.video || ''} />
						</div>
					</div>
				</div>
			</div>

			<div class="form-actions">
				<a href="/admin" class="btn-sm btn-cancel">Cancelar</a>
				<button type="submit" class="btn-primary" id="submitBtn">
					{isEdit ? 'Guardar Cambios' : 'Crear Propiedad'}
				</button>
			</div>
		</form>
	</main>
</body>
</html>

<script>
	const form = document.getElementById('propertyForm') as HTMLFormElement;
	const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
	const fileInput = document.getElementById('fileInput') as HTMLInputElement;
	const uploadArea = document.getElementById('uploadArea') as HTMLDivElement;
	const uploadProgress = document.getElementById('uploadProgress') as HTMLDivElement;
	const imagesList = document.getElementById('imagesList') as HTMLDivElement;
	const addUrlBtn = document.getElementById('addUrlBtn') as HTMLButtonElement;
	const manualUrlInput = document.getElementById('manualImageUrl') as HTMLInputElement;

	// --- Cascading Location Selects ---
	const provinciaSelect = document.getElementById('provincia_id') as HTMLSelectElement;
	const cantonSelect = document.getElementById('canton_id') as HTMLSelectElement;
	const distritoSelect = document.getElementById('distrito_id') as HTMLSelectElement;
	const API_BASE = 'https://ubicaciones.paginasweb.cr';

	async function loadProvincias() {
		try {
			const res = await fetch(`${API_BASE}/provincias.json`);
			const data = await res.json();
			Object.entries(data).forEach(([id, name]) => {
				const opt = document.createElement('option');
				opt.value = id;
				opt.textContent = name as string;
				provinciaSelect.appendChild(opt);
			});
			const initial = provinciaSelect.getAttribute('data-initial');
			if (initial) {
				provinciaSelect.value = initial;
				await loadCantones(initial);
			}
		} catch (e) {
			console.error('Error loading provincias:', e);
		}
	}

	async function loadCantones(provinciaId: string) {
		cantonSelect.innerHTML = '<option value="">Seleccionar cantón</option>';
		cantonSelect.disabled = true;
		distritoSelect.innerHTML = '<option value="">Seleccionar distrito</option>';
		distritoSelect.disabled = true;
		if (!provinciaId) return;
		try {
			const res = await fetch(`${API_BASE}/provincia/${provinciaId}/cantones.json`);
			const data = await res.json();
			Object.entries(data).forEach(([id, name]) => {
				const opt = document.createElement('option');
				opt.value = id;
				opt.textContent = name as string;
				cantonSelect.appendChild(opt);
			});
			cantonSelect.disabled = false;
			const initial = cantonSelect.getAttribute('data-initial');
			if (initial) {
				cantonSelect.value = initial;
				cantonSelect.removeAttribute('data-initial');
				await loadDistritos(provinciaId, initial);
			}
		} catch (e) {
			console.error('Error loading cantones:', e);
		}
	}

	async function loadDistritos(provinciaId: string, cantonId: string) {
		distritoSelect.innerHTML = '<option value="">Seleccionar distrito</option>';
		distritoSelect.disabled = true;
		if (!cantonId) return;
		try {
			const res = await fetch(`${API_BASE}/provincia/${provinciaId}/canton/${cantonId}/distritos.json`);
			const data = await res.json();
			Object.entries(data).forEach(([id, name]) => {
				const opt = document.createElement('option');
				opt.value = id;
				opt.textContent = name as string;
				distritoSelect.appendChild(opt);
			});
			distritoSelect.disabled = false;
			const initial = distritoSelect.getAttribute('data-initial');
			if (initial) {
				distritoSelect.value = initial;
				distritoSelect.removeAttribute('data-initial');
			}
		} catch (e) {
			console.error('Error loading distritos:', e);
		}
	}

	provinciaSelect.addEventListener('change', () => loadCantones(provinciaSelect.value));
	cantonSelect.addEventListener('change', () => loadDistritos(provinciaSelect.value, cantonSelect.value));
	loadProvincias();

	// --- Property type: toggle required fields for beds/baths/parking ---
	const propertyTypeSelect = document.getElementById('property_type') as HTMLSelectElement;
	const typesWithoutRooms = ['Lote', 'Finca', 'Comercial'];

	function updateCharFields() {
		const pType = propertyTypeSelect.value;
		const required = !typesWithoutRooms.includes(pType);
		const bedsLabel = document.getElementById('bedsLabel')!;
		const bathsLabel = document.getElementById('bathsLabel')!;
		const parkingLabel = document.getElementById('parkingLabel')!;
		const bedsField = document.getElementById('bedsField')!;
		const bathsField = document.getElementById('bathsField')!;
		const parkingField = document.getElementById('parkingField')!;

		bedsLabel.textContent = required ? 'Habitaciones *' : 'Habitaciones';
		bathsLabel.textContent = required ? 'Baños *' : 'Baños';
		parkingLabel.textContent = required ? 'Parqueos *' : 'Parqueos';

		[bedsField, bathsField, parkingField].forEach(f => {
			if (required) {
				f.classList.remove('field-disabled');
			} else {
				f.classList.add('field-disabled');
			}
		});

		// Clear warnings when switching type
		document.querySelectorAll('.field-warn').forEach(w => w.classList.add('hidden'));
	}

	propertyTypeSelect.addEventListener('change', updateCharFields);
	updateCharFields();

	// Auto-fill price display fields
	const priceInput = document.getElementById('price') as HTMLInputElement;
	const priceDisplayInput = document.getElementById('price_display') as HTMLInputElement;
	const priceUsdInput = document.getElementById('price_usd') as HTMLInputElement;
	const priceDisplayUsdInput = document.getElementById('price_display_usd') as HTMLInputElement;

	priceInput.addEventListener('input', () => {
		const val = parseFloat(priceInput.value);
		priceDisplayInput.value = isNaN(val) ? '' : '₡' + val.toLocaleString('en-US');
	});

	priceUsdInput.addEventListener('input', () => {
		const val = parseFloat(priceUsdInput.value);
		priceDisplayUsdInput.value = isNaN(val) ? '' : '$' + val.toLocaleString('en-US');
	});

	// Collect current image URLs
	function getImageUrls(): string[] {
		return Array.from(imagesList.querySelectorAll('.image-item'))
			.map(item => item.getAttribute('data-url')!)
			.filter(Boolean);
	}

	// Add image to list
	function addImageToList(url: string) {
		const div = document.createElement('div');
		div.className = 'image-item';
		div.setAttribute('data-url', url);
		div.setAttribute('draggable', 'true');
		div.innerHTML = `<span class="drag-handle">⠿</span><img src="${url}" alt="Imagen" /><button type="button" class="btn-remove-img" title="Eliminar">&times;</button>`;
		div.querySelector('.btn-remove-img')!.addEventListener('click', () => div.remove());
		initDragItem(div);
		imagesList.appendChild(div);
	}

	// Remove image buttons
	document.querySelectorAll('.btn-remove-img').forEach(btn => {
		btn.addEventListener('click', () => btn.closest('.image-item')!.remove());
	});

	// --- Drag and Drop reorder ---
	let draggedItem: HTMLElement | null = null;

	function initDragItem(item: Element) {
		item.addEventListener('dragstart', (e: Event) => {
			const ev = e as DragEvent;
			draggedItem = item as HTMLElement;
			draggedItem.classList.add('dragging');
			ev.dataTransfer!.effectAllowed = 'move';
		});

		item.addEventListener('dragend', () => {
			if (draggedItem) {
				draggedItem.classList.remove('dragging');
				draggedItem = null;
			}
			imagesList.querySelectorAll('.image-item').forEach(el => el.classList.remove('drag-over'));
		});

		item.addEventListener('dragover', (e: Event) => {
			e.preventDefault();
			(e as DragEvent).dataTransfer!.dropEffect = 'move';
			if (draggedItem && item !== draggedItem) {
				item.classList.add('drag-over');
			}
		});

		item.addEventListener('dragleave', () => {
			item.classList.remove('drag-over');
		});

		item.addEventListener('drop', (e: Event) => {
			e.preventDefault();
			item.classList.remove('drag-over');
			if (!draggedItem || item === draggedItem) return;
			const items = Array.from(imagesList.querySelectorAll('.image-item'));
			const dragIdx = items.indexOf(draggedItem);
			const dropIdx = items.indexOf(item as HTMLElement);
			if (dragIdx < dropIdx) {
				imagesList.insertBefore(draggedItem, item.nextSibling);
			} else {
				imagesList.insertBefore(draggedItem, item);
			}
		});
	}

	// Init drag on existing items
	imagesList.querySelectorAll('.image-item').forEach(initDragItem);

	// Add URL manually
	addUrlBtn.addEventListener('click', () => {
		const url = manualUrlInput.value.trim();
		if (url) {
			addImageToList(url);
			manualUrlInput.value = '';
		}
	});

	// Drag and drop
	uploadArea.addEventListener('dragover', (e) => {
		e.preventDefault();
		uploadArea.classList.add('dragover');
	});
	uploadArea.addEventListener('dragleave', () => uploadArea.classList.remove('dragover'));
	uploadArea.addEventListener('drop', async (e) => {
		e.preventDefault();
		uploadArea.classList.remove('dragover');
		if (e.dataTransfer?.files.length) {
			await uploadFiles(e.dataTransfer.files);
		}
	});

	fileInput.addEventListener('change', async () => {
		if (fileInput.files?.length) {
			await uploadFiles(fileInput.files);
			fileInput.value = '';
		}
	});

	function resizeImage(file: File, maxSize: number, quality: number): Promise<Blob> {
		return new Promise((resolve, reject) => {
			const img = new Image();
			img.onload = () => {
				let { width, height } = img;
				if (width > maxSize || height > maxSize) {
					if (width > height) {
						height = Math.round(height * maxSize / width);
						width = maxSize;
					} else {
						width = Math.round(width * maxSize / height);
						height = maxSize;
					}
				}
				const canvas = document.createElement('canvas');
				canvas.width = width;
				canvas.height = height;
				const ctx = canvas.getContext('2d')!;
				ctx.drawImage(img, 0, 0, width, height);
				canvas.toBlob(
					blob => blob ? resolve(blob) : reject(new Error('Error al procesar imagen')),
					'image/jpeg',
					quality
				);
			};
			img.onerror = () => reject(new Error('Error al cargar imagen'));
			img.src = URL.createObjectURL(file);
		});
	}

	async function uploadFiles(files: FileList) {
		uploadProgress.classList.remove('hidden');
		uploadProgress.textContent = `Procesando ${files.length} imagen(es)...`;

		const formData = new FormData();
		for (let i = 0; i < files.length; i++) {
			const file = files[i];
			uploadProgress.textContent = `Redimensionando ${i + 1}/${files.length}...`;
			try {
				const resized = await resizeImage(file, 1600, 0.80);
				formData.append('files', resized, file.name.replace(/\.[^.]+$/, '.jpg'));
			} catch {
				formData.append('files', file);
			}
		}

		uploadProgress.textContent = `Subiendo ${files.length} imagen(es)...`;

		try {
			const res = await fetch('/api/upload', { method: 'POST', body: formData });
			const data = await res.json();

			if (data.urls) {
				data.urls.forEach((url: string) => addImageToList(url));
				uploadProgress.textContent = `${data.urls.length} imagen(es) subida(s)`;
			} else {
				uploadProgress.textContent = `Error: ${data.error}`;
			}
		} catch (err) {
			uploadProgress.textContent = 'Error al subir imágenes';
		}

		setTimeout(() => uploadProgress.classList.add('hidden'), 3000);
	}

	// Form submit
	form.addEventListener('submit', async (e) => {
		e.preventDefault();

		// Validate beds/baths/parking for Casa and Apartamento
		const pType = propertyTypeSelect.value;
		const requiresRooms = !typesWithoutRooms.includes(pType);

		if (requiresRooms) {
			const bedsVal = parseInt((document.getElementById('beds') as HTMLInputElement).value) || 0;
			const bathsVal = parseFloat((document.getElementById('baths') as HTMLInputElement).value) || 0;
			const parkingVal = parseInt((document.getElementById('parking') as HTMLInputElement).value) || 0;
			const bedsWarn = document.getElementById('bedsWarn')!;
			const bathsWarn = document.getElementById('bathsWarn')!;
			const parkingWarn = document.getElementById('parkingWarn')!;

			let hasError = false;
			bedsWarn.classList.add('hidden');
			bathsWarn.classList.add('hidden');
			parkingWarn.classList.add('hidden');

			if (bedsVal <= 0) { bedsWarn.classList.remove('hidden'); hasError = true; }
			if (bathsVal <= 0) { bathsWarn.classList.remove('hidden'); hasError = true; }
			if (parkingVal <= 0) { parkingWarn.classList.remove('hidden'); hasError = true; }

			if (hasError) {
				alert(`Las propiedades tipo "${pType}" requieren al menos 1 habitación, 1 baño y 1 parqueo.`);
				return;
			}
		}

		submitBtn.disabled = true;
		submitBtn.textContent = 'Guardando...';

		const propertyId = (document.getElementById('propertyId') as HTMLInputElement).value;
		const isEdit = !!propertyId;

		const body = {
			title: (document.getElementById('title') as HTMLInputElement).value,
			type: (document.getElementById('type') as HTMLSelectElement).value,
			property_type: (document.getElementById('property_type') as HTMLSelectElement).value,
			status: (document.getElementById('status') as HTMLSelectElement).value,
			price: parseFloat((document.getElementById('price') as HTMLInputElement).value) || 0,
			price_display: (document.getElementById('price_display') as HTMLInputElement).value || '',
			price_usd: parseFloat((document.getElementById('price_usd') as HTMLInputElement).value) || 0,
			price_display_usd: (document.getElementById('price_display_usd') as HTMLInputElement).value || '',
			location: (document.getElementById('location') as HTMLInputElement).value,
			provincia_id: (document.getElementById('provincia_id') as HTMLInputElement).value || null,
			canton_id: (document.getElementById('canton_id') as HTMLInputElement).value || null,
			distrito_id: (document.getElementById('distrito_id') as HTMLInputElement).value || null,
			lat: parseFloat((document.getElementById('lat') as HTMLInputElement).value) || null,
			lng: parseFloat((document.getElementById('lng') as HTMLInputElement).value) || null,
			beds: parseInt((document.getElementById('beds') as HTMLInputElement).value) || 0,
			baths: parseFloat((document.getElementById('baths') as HTMLInputElement).value) || 0,
			area: (document.getElementById('area') as HTMLInputElement).value,
			parking: parseInt((document.getElementById('parking') as HTMLInputElement).value) || 0,
			description: (document.getElementById('description') as HTMLTextAreaElement).value || null,
			notes: (document.getElementById('notes') as HTMLTextAreaElement).value || null,
			images: getImageUrls(),
			contact_number: (document.getElementById('contact_number') as HTMLInputElement).value || '50670141868',
			instagram: (document.getElementById('instagram') as HTMLInputElement).value || null,
			video: (document.getElementById('video') as HTMLInputElement).value || null,
		};

		try {
			const url = isEdit ? `/api/properties/${propertyId}` : '/api/properties';
			const method = isEdit ? 'PUT' : 'POST';

			const res = await fetch(url, {
				method,
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(body),
			});

			if (res.ok) {
				window.location.href = '/admin';
			} else {
				const data = await res.json();
				alert(`Error: ${data.error}`);
				submitBtn.disabled = false;
				submitBtn.textContent = isEdit ? 'Guardar Cambios' : 'Crear Propiedad';
			}
		} catch (err) {
			alert('Error de conexión');
			submitBtn.disabled = false;
			submitBtn.textContent = isEdit ? 'Guardar Cambios' : 'Crear Propiedad';
		}
	});

	// --- Notes ---
	const notesTextarea = document.getElementById('notes') as HTMLTextAreaElement;
	const notesList = document.getElementById('notesList') as HTMLDivElement;
	const noteInput = document.getElementById('noteInput') as HTMLInputElement;

	function serializeNotes() {
		const items = notesList.querySelectorAll<HTMLElement>('.note-item');
		notesTextarea.value = Array.from(items).map(el => el.dataset.text || '').filter(Boolean).join('\n');
	}

	function addNote(text: string) {
		const t = text.trim();
		if (!t) return;
		const item = document.createElement('div');
		item.className = 'note-item';
		item.dataset.text = t;
		item.innerHTML = `<span class="note-text">${t.replace(/</g, '&lt;')}</span><button type="button" class="note-remove" title="Eliminar">&times;</button>`;
		item.querySelector('.note-remove')!.addEventListener('click', () => { item.remove(); serializeNotes(); });
		notesList.appendChild(item);
		serializeNotes();
	}

	function commitNote() {
		addNote(noteInput.value);
		noteInput.value = '';
		noteInput.focus();
	}

	document.getElementById('addNoteRow')!.addEventListener('click', commitNote);
	noteInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); commitNote(); } });

	document.getElementById('saveNotesBtn')!.addEventListener('click', () => {
		form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
	});

	// Load existing
	const existingNotes = notesTextarea.value.trim();
	if (existingNotes) {
		existingNotes.split('\n').forEach(line => {
			const sep = line.indexOf('::');
			addNote(sep >= 0 ? `${line.slice(0, sep)}: ${line.slice(sep + 2)}` : line);
		});
	}
</script>

