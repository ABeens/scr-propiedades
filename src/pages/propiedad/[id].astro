---
import Layout from '../../layouts/Layout.astro';
import { properties } from '../../data/properties';

export function getStaticPaths() {
	return properties.map(p => ({
		params: { id: p.id },
		props: { property: p },
	}));
}

const { property } = Astro.props;
const base = import.meta.env.BASE_URL;

const whatsappMessage = `Hola, me interesa la propiedad: ${property.title} (${property.priceDisplay} / ${property.priceDisplayUSD}). ¿Podrían darme más información?`;
const whatsappLink = `https://wa.me/${property.contactNumber}?text=${encodeURIComponent(whatsappMessage)}`;

const propertyUrl = `https://abeens.github.io${base}/propiedad/${property.id}`;
const shareText = encodeURIComponent(`Mirá esta propiedad: ${property.title} - ${property.priceDisplay} (${property.priceDisplayUSD})\n${propertyUrl}`);
const shareLink = `https://wa.me/?text=${shareText}`;
---

<Layout title={property.title} showWhatsApp={true} whatsAppNumber={property.contactNumber} whatsAppMessage={whatsappMessage}>
	<header class="header">
		<div class="container nav-wrapper">
			<div class="logo">
				<a href={base}>
					<img src={`${base}/main-logo.png`} alt="Main Logo" height="80" />
				</a>
			</div>
			<button class="hamburger" id="hamburgerBtn" aria-label="Abrir menú">
				<span></span>
				<span></span>
				<span></span>
			</button>
			<nav class="nav" id="mainNav">
				<a href={base}>Inicio</a>
				<a href={`${base}/catalog?type=sale`}>Comprar</a>
				<a href={`${base}/catalog?type=rent`}>Alquilar</a>
				<a href={`${base}/#contacto`} class="btn-outline">Contacto</a>
			</nav>
		</div>
	</header>

	<main class="detail-page">
		<section class="detail-hero">
			<img src={property.images[0]} alt={property.title} class="hero-image" />
			<div class="hero-overlay">
				<div class="container">
					<a href={`${base}/catalog`} class="back-link">&larr; Volver al catálogo</a>
					<h1>{property.title}</h1>
					<p class="hero-location">{property.location}</p>
				</div>
			</div>
		</section>

		<section class="detail-content container">
			<div class="detail-grid">
				<div class="detail-main">
					<div class="price-row">
						<span class="detail-price">{property.priceDisplay} | <span class="detail-price-usd">{property.priceDisplayUSD}</span></span>
						<span class="detail-badge">{property.type === 'sale' ? 'Comprar' : 'Alquilar'}</span>
						<span class="detail-status">{property.status}</span>
					</div>

					<div class="specs-bar">
						{property.beds > 0 && (
							<div class="spec-item">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v11m0-4h18m0 4V8a3 3 0 0 0-3-3H6a3 3 0 0 0-3 3"/><path d="M7 11V7"/><path d="M17 11V7"/></svg>
								<span>{property.beds} Habitaciones</span>
							</div>
						)}
						{property.baths > 0 && (
							<div class="spec-item">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16a1 1 0 0 1 1 1v3a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4v-3a1 1 0 0 1 1-1z"/><path d="M6 12V5a2 2 0 0 1 2-2h3v2.25"/></svg>
								<span>{property.baths} Baños</span>
							</div>
						)}
						<div class="spec-item">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 12h18"/><path d="M12 3v18"/></svg>
							<span>{property.area}</span>
						</div>
						{property.parking > 0 && (
							<div class="spec-item">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/></svg>
								<span>{property.parking} Parqueos</span>
							</div>
						)}
					</div>

					<div class="description">
						<h2>Descripción</h2>
						<p>{property.description}</p>
					</div>

					<div class="gallery">
						<h2>Galería</h2>
						<div class="gallery-grid">
							{property.images.map((img, i) => (
								<div class={`gallery-item ${i === 0 ? 'gallery-item--large' : ''}`}>
									<img src={img} alt={`${property.title} - Foto ${i + 1}`} loading="lazy" />
								</div>
							))}
						</div>
					</div>

					<div class="media-section">
						<h2>Video y Redes</h2>
						<div class="media-links">
							<a href={property.video} target="_blank" rel="noopener noreferrer" class="media-card">
								<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
								<span>Ver video del recorrido</span>
							</a>
							<a href={property.instagram} target="_blank" rel="noopener noreferrer" class="media-card">
								<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
								<span>Ver en Instagram</span>
							</a>
						</div>
					</div>

					<div class="map-section">
						<h2>Ubicación Aproximada</h2>
						<p class="map-note">La ubicación mostrada es aproximada para proteger la privacidad de la propiedad.</p>
						<div id="map" data-lat={property.lat} data-lng={property.lng}></div>
					</div>
				</div>

				<aside class="detail-sidebar">
					<div class="contact-card">
						<h3>¿Te interesa esta propiedad?</h3>
						<p>Contáctanos directamente por WhatsApp para agendar una visita o recibir más información.</p>
						<a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn-whatsapp">
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
							Contactar por WhatsApp
						</a>
						<p class="contact-phone">+506 7014 1868</p>
					</div>
					<a href={shareLink} target="_blank" rel="noopener noreferrer" class="btn-share">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
						Compartir por WhatsApp
					</a>
				</aside>
			</div>
		</section>
	</main>


	<footer class="footer">
		<div class="container footer-grid">
			<div class="footer-brand">
				<img src={`${base}/main-logo.png`} alt="Logo" height="40" />
				<p>Excelencia en servicios inmobiliarios.</p>
			</div>
			<div class="footer-links">
				<h4>Navegación</h4>
				<a href={`${base}/catalog?type=sale`}>Comprar</a>
				<a href={`${base}/catalog?type=rent`}>Alquilar</a>
				<a href={`${base}/#contacto`}>Contacto</a>
			</div>
			<div class="footer-contact">
				<h4>Contacto</h4>
				<p>San José, Costa Rica</p>
				<p>+506 7014 1868</p>
			</div>
		</div>
		<div class="footer-bottom">
			<p>&copy; 2024 Real Estate. Todos los derechos reservados.</p>
		</div>
	</footer>
</Layout>

<script>
	// Hamburger menu
	const hamburgerBtn = document.getElementById('hamburgerBtn');
	const mainNav = document.getElementById('mainNav');

	hamburgerBtn?.addEventListener('click', () => {
		hamburgerBtn.classList.toggle('active');
		mainNav?.classList.toggle('active');
		document.body.style.overflow = mainNav?.classList.contains('active') ? 'hidden' : '';
	});

	mainNav?.querySelectorAll('a').forEach(link => {
		link.addEventListener('click', () => {
			hamburgerBtn?.classList.remove('active');
			mainNav?.classList.remove('active');
			document.body.style.overflow = '';
		});
	});

	// Gallery lightbox
	const galleryItems = document.querySelectorAll('.gallery-item img');
	const lightbox = document.getElementById('lightbox');
	const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement;
	const lightboxClose = document.getElementById('lightboxClose');

	galleryItems.forEach(img => {
		img.addEventListener('click', () => {
			if (lightbox && lightboxImg) {
				lightboxImg.src = (img as HTMLImageElement).src;
				lightbox.classList.add('active');
				document.body.style.overflow = 'hidden';
			}
		});
	});

	lightboxClose?.addEventListener('click', () => {
		lightbox?.classList.remove('active');
		document.body.style.overflow = '';
	});

	lightbox?.addEventListener('click', (e) => {
		if (e.target === lightbox) {
			lightbox.classList.remove('active');
			document.body.style.overflow = '';
		}
	});

	// Leaflet map
	const mapEl = document.getElementById('map');
	if (mapEl) {
		const lat = parseFloat(mapEl.getAttribute('data-lat') || '0');
		const lng = parseFloat(mapEl.getAttribute('data-lng') || '0');

		const link = document.createElement('link');
		link.rel = 'stylesheet';
		link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
		document.head.appendChild(link);

		const script = document.createElement('script');
		script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
		script.onload = () => {
			const L = (window as any).L;
			const map = L.map('map', {
				scrollWheelZoom: false,
			}).setView([lat, lng], 14);

			L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
				attribution: '&copy; OpenStreetMap',
			}).addTo(map);

			L.circle([lat, lng], {
				color: '#c5a059',
				fillColor: '#c5a059',
				fillOpacity: 0.15,
				radius: 800,
				weight: 2,
			}).addTo(map);
		};
		document.head.appendChild(script);
	}
</script>

<!-- Lightbox -->
<div id="lightbox" class="lightbox">
	<button id="lightboxClose" class="lightbox-close">&times;</button>
	<img id="lightboxImg" src="" alt="Vista ampliada" />
</div>

<style>
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	/* Header */
	.header {
		position: sticky;
		top: 0;
		width: 100%;
		z-index: 100;
		padding: 1rem 0;
		background: rgba(255, 255, 255, 0.98);
		border-bottom: 1px solid rgba(0,0,0,0.08);
		backdrop-filter: blur(10px);
	}

	.nav-wrapper {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.nav {
		display: flex;
		gap: 2rem;
		align-items: center;
		font-weight: 500;
		text-transform: uppercase;
		font-size: 0.85rem;
		letter-spacing: 1px;
	}

	.nav a { color: var(--primary); }
	.nav a:hover { color: var(--accent); }

	.btn-outline {
		padding: 0.5rem 1.2rem;
		border: 1px solid var(--primary);
		transition: all 0.3s;
	}
	.btn-outline:hover {
		background: var(--primary);
		color: var(--white) !important;
	}

	/* Detail Hero */
	.detail-hero {
		position: relative;
		height: 50vh;
		min-height: 350px;
		overflow: hidden;
	}

	.hero-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 60%);
		display: flex;
		align-items: flex-end;
		padding-bottom: 3rem;
	}

	.hero-overlay h1 {
		color: var(--white);
		font-size: 2.8rem;
		margin-bottom: 0.5rem;
	}

	.hero-location {
		color: rgba(255,255,255,0.85);
		font-size: 1.1rem;
	}

	.back-link {
		display: inline-block;
		color: rgba(255,255,255,0.8);
		font-size: 0.9rem;
		margin-bottom: 1rem;
		transition: color 0.3s;
	}
	.back-link:hover { color: var(--white); }

	/* Detail Content */
	.detail-content {
		padding: 3rem 2rem;
	}

	.detail-grid {
		display: grid;
		grid-template-columns: 1fr 350px;
		gap: 3rem;
	}

	/* Price Row */
	.price-row {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin-bottom: 2rem;
		flex-wrap: wrap;
	}

	.detail-price {
		font-size: 1.8rem;
		font-weight: 700;
		color: var(--primary);
		font-family: 'Playfair Display', serif;
	}

	.detail-price-usd {
		color: var(--accent);
	}

	.detail-badge {
		background: var(--accent);
		color: #fff;
		padding: 0.3rem 0.8rem;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.5px;
	}

	.detail-status {
		background: var(--secondary);
		color: var(--text-muted);
		padding: 0.3rem 0.8rem;
		font-size: 0.8rem;
		font-weight: 500;
	}

	/* Specs Bar */
	.specs-bar {
		display: flex;
		gap: 2rem;
		padding: 1.5rem 0;
		border-top: 1px solid #eee;
		border-bottom: 1px solid #eee;
		margin-bottom: 2.5rem;
		flex-wrap: wrap;
	}

	.spec-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--text-muted);
		font-size: 0.95rem;
	}

	.spec-item svg { color: var(--accent); }

	/* Description */
	.description {
		margin-bottom: 3rem;
	}

	.description h2,
	.gallery h2,
	.media-section h2 {
		font-size: 1.8rem;
		margin-bottom: 1.2rem;
	}

	.description p {
		color: var(--text-muted);
		line-height: 1.8;
		font-size: 1.05rem;
	}

	/* Gallery */
	.gallery {
		margin-bottom: 3rem;
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.gallery-item {
		border-radius: 8px;
		overflow: hidden;
		cursor: pointer;
		aspect-ratio: 4/3;
	}

	.gallery-item--large {
		grid-column: span 2;
		grid-row: span 2;
		aspect-ratio: auto;
	}

	.gallery-item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s;
	}

	.gallery-item:hover img {
		transform: scale(1.05);
	}

	/* Media Section */
	.media-section {
		margin-bottom: 3rem;
	}

	/* Map */
	.map-section {
		margin-bottom: 3rem;
	}

	.map-section h2 {
		font-size: 1.8rem;
		margin-bottom: 0.5rem;
	}

	.map-note {
		color: var(--text-muted);
		font-size: 0.85rem;
		margin-bottom: 1rem;
		font-style: italic;
	}

	#map {
		width: 100%;
		height: 400px;
		border-radius: 8px;
		border: 1px solid #eee;
		z-index: 1;
	}

	.media-links {
		display: flex;
		gap: 1.5rem;
	}

	.media-card {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.8rem;
		padding: 2rem;
		border: 1px solid #eee;
		border-radius: 8px;
		text-align: center;
		color: var(--text-muted);
		transition: all 0.3s;
	}

	.media-card:hover {
		border-color: var(--accent);
		color: var(--accent);
		transform: translateY(-3px);
		box-shadow: 0 8px 20px rgba(0,0,0,0.06);
	}

	.media-card svg { color: var(--accent); }

	/* Sidebar */
	.contact-card {
		background: #fff;
		border: 1px solid #eee;
		border-radius: 8px;
		padding: 2rem;
		position: sticky;
		top: 100px;
		text-align: center;
	}

	.contact-card h3 {
		font-size: 1.3rem;
		margin-bottom: 1rem;
	}

	.contact-card > p {
		color: var(--text-muted);
		font-size: 0.95rem;
		margin-bottom: 1.5rem;
		line-height: 1.6;
	}

	.btn-whatsapp {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		width: 100%;
		padding: 1rem;
		background: #25D366;
		color: #fff;
		border: none;
		border-radius: 8px;
		font-family: inherit;
		font-weight: 600;
		font-size: 1rem;
		cursor: pointer;
		transition: all 0.3s;
	}

	.btn-whatsapp:hover {
		background: #1da851;
		transform: translateY(-2px);
		box-shadow: 0 6px 16px rgba(37, 211, 102, 0.3);
		color: #fff;
	}

	.contact-phone {
		margin-top: 1rem !important;
		font-size: 0.85rem !important;
		color: var(--text-muted) !important;
	}

	.btn-share {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		width: 100%;
		margin-top: 1rem;
		padding: 0.8rem;
		background: transparent;
		color: var(--text-muted);
		border: 1px solid #ddd;
		border-radius: 8px;
		font-family: inherit;
		font-size: 0.9rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.3s;
		text-align: center;
	}

	.btn-share:hover {
		border-color: #25D366;
		color: #25D366;
	}


	/* Lightbox */
	.lightbox {
		display: none;
		position: fixed;
		inset: 0;
		background: rgba(0,0,0,0.9);
		z-index: 1000;
		align-items: center;
		justify-content: center;
		padding: 2rem;
	}

	.lightbox.active {
		display: flex;
	}

	.lightbox img {
		max-width: 90%;
		max-height: 90vh;
		object-fit: contain;
		border-radius: 4px;
	}

	.lightbox-close {
		position: absolute;
		top: 1.5rem;
		right: 2rem;
		background: none;
		border: none;
		color: #fff;
		font-size: 2.5rem;
		cursor: pointer;
		line-height: 1;
	}

	/* Footer */
	.footer {
		padding: 4rem 0 2rem;
		border-top: 1px solid #eee;
		background: #fff;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 3rem;
		margin-bottom: 3rem;
	}

	.footer-brand p {
		margin-top: 1rem;
		color: var(--text-muted);
		max-width: 250px;
	}

	.footer h4 {
		margin-bottom: 1.2rem;
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.footer-links a, .footer-contact p {
		display: block;
		margin-bottom: 0.7rem;
		color: var(--text-muted);
	}

