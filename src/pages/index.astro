---
import Layout from "../layouts/Layout.astro";
import PropertyCard from "../components/PropertyCard.astro";

const { env } = Astro.locals.runtime;
const { results } = await env.DB.prepare("SELECT * FROM properties WHERE status NOT IN ('sold', 'rented') ORDER BY created_at DESC LIMIT 3").all();
const featured = results.map((row: any) => ({
	...row,
	images: JSON.parse(row.images || '[]'),
	priceDisplay: row.price_display,
	priceDisplayUSD: row.price_display_usd,
	priceUSD: row.price_usd,
	propertyType: row.property_type,
	contactNumber: row.contact_number,
}));
const publishWhatsAppMessage = encodeURIComponent(
	"Hola, me interesa publicar mi propiedad con ustedes.",
);
const publishWhatsAppLink = `https://wa.me/50670141868?text=${publishWhatsAppMessage}`;
---

<Layout showWhatsApp={true}>
	<header class="header">
		<div class="container nav-wrapper">
			<div class="logo">
				<img
					src={`/main-logo-dark-mode.png`}
					alt="Main Logo"
					height="80"
				/>
			</div>
			<button class="hamburger" id="hamburgerBtn" aria-label="Abrir menú">
				<span></span>
				<span></span>
				<span></span>
			</button>
			<nav class="nav" id="mainNav">
				<a href="#inicio">Inicio</a>
				<a href={`/catalog?type=sale`}>Comprar</a>
				<a href={`/catalog?type=rent`}>Alquilar</a>
				<a href="#contacto" class="btn-outline">Contacto</a>
			</nav>
		</div>
	</header>

	<main>
		<section class="hero" id="inicio">
			<div class="video-background">
				<video
					autoplay
					muted
					loop
					playsinline
					poster={`/bg-white.png`}
				>
					<source src={`/bg-video.mp4`} type="video/mp4" />
					Su navegador no soporta videos.
				</video>
			</div>
			<div class="container">
				<div class="hero-content">
					<h2>Asesoría inmobiliaria adaptada a sus necesidades.</h2>
					<p>Orientación profesional para decisiones importantes.</p>

					<div class="search-box">
						<p class="search-label">
							¿Qué desea hacer? Nosotros le ayudamos
						</p>
						<div class="search-buttons">
							<a
								href={`/catalog?type=sale`}
								class="btn-option">Comprar</a
							>
							<a
								href={`/catalog?type=rent`}
								class="btn-option">Alquilar</a
							>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="featured container" id="venta">
			<div class="section-header">
				<h2>Propiedades Destacadas</h2>
			</div>

			<div class="property-grid">
				{featured.map((prop) => (
					<PropertyCard
						id={prop.id}
						title={prop.title}
						type={prop.type}
						location={prop.location}
						provinciaId={prop.provinciaId}
						cantonId={prop.cantonId}
						distritoId={prop.distritoId}
						beds={prop.beds}
						baths={prop.baths}
						parking={prop.parking}
						area={prop.area}
						price={prop.price}
						priceUSD={prop.priceUSD}
						priceDisplay={prop.priceDisplay}
						priceDisplayUSD={prop.priceDisplayUSD}
						propertyType={prop.propertyType}
						status={prop.status}
						image={prop.images[0]}
					/>
				))}
			</div>
		</section>

		<section class="cta">
			<div class="container">
				<h2>¿Listo para vender o alquilar su propiedad?</h2>
				<p>
					Permítanos ayudarle a encontrar al comprador ideal con
					nuestra red exclusiva.
				</p>
				<a
					href={publishWhatsAppLink}
					target="_blank"
					rel="noopener noreferrer"
					class="btn-primary">Contáctenos Hoy</a
				>
			</div>
		</section>
	</main>

	<footer class="footer">
		<div class="container footer-grid">
			<div class="footer-brand">
				<img src={`/main-logo.png`} alt="Logo" height="80" />
				<p>Excelencia en servicios inmobiliarios.</p>
			</div>
			<div class="footer-links">
				<h4>Navegación</h4>
				<a href={`/catalog?type=sale`}>Comprar</a>
				<a href={`/catalog?type=rent`}>Alquilar</a>
				<a href="/">Nosotros</a>
			</div>
			<div class="footer-contact" id="contacto">
				<h4>Contacto</h4>
				<p>San José, Costa Rica</p>
				<p>+506 7014 1868</p>
			</div>
		</div>
		<div class="footer-bottom">
			<p>&copy; 2024 Real Estate. Todos los derechos reservados.</p>
		</div>
	</footer>
</Layout>

<script is:inline>
	const header = document.querySelector(".header");
	window.addEventListener("scroll", () => {
		if (window.scrollY > 50) {
			header.classList.add("scrolled");
			const logo = document.querySelector(".logo img");
			logo.src = "/main-logo.png";
		} else {
			header.classList.remove("scrolled");
			const logo = document.querySelector(".logo img");
			logo.src = "/main-logo-dark-mode.png";
		}
	});

	// Hamburger menu
	const hamburgerBtn = document.getElementById("hamburgerBtn");
	const mainNav = document.getElementById("mainNav");

	hamburgerBtn.addEventListener("click", () => {
		hamburgerBtn.classList.toggle("active");
		mainNav.classList.toggle("active");
		document.body.style.overflow = mainNav.classList.contains("active")
			? "hidden"
			: "";
	});

	mainNav.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => {
			hamburgerBtn.classList.remove("active");
			mainNav.classList.remove("active");
			document.body.style.overflow = "";
		});
	});
</script>

<style>
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.header {
		position: fixed;
		top: 0;
		width: 100%;
		z-index: 100;
		padding: 1.5rem 0;
		background: transparent;
		transition: background 0.3s ease;
	}

	.header.scrolled {
		background: rgba(255, 255, 255, 0.95);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(0, 0, 0, 0.05);
	}

	.nav-wrapper {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.nav {
		display: flex;
		gap: 2.5rem;
		align-items: center;
		font-weight: 500;
		text-transform: uppercase;
		font-size: 0.85rem;
		letter-spacing: 1px;
		color: var(--white);
	}

	.nav a:hover {
		color: var(--accent);
	}

	.btn-outline {
		padding: 0.6rem 1.5rem;
		border: 1px solid var(--white);
		color: var(--white) !important;
		transition: all 0.3s;
	}

	.btn-outline:hover {
		background: var(--primary);
		color: var(--white) !important;
	}

	.header.scrolled .nav {
		color: var(--primary);
	}

	.header.scrolled .btn-outline {
		border-color: var(--primary);
		color: var(--primary) !important;
	}

	.header.scrolled .btn-outline:hover {
		background: var(--primary);
		color: var(--white) !important;
	}

	.hero {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		position: relative;
		overflow: hidden;
	}

	.video-background {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		pointer-events: none;
	}

	.video-background video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		position: absolute;
		top: 0;
		left: 0;
	}

	.hero::before {
		content: "";
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.5);
		z-index: 1;
	}

	.hero .container {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.hero-content {
		z-index: 2;
	}

	.hero h1 {
		font-size: 4rem;
		line-height: 1.1;
		margin-bottom: 1.5rem;
		color: var(--white);
	}

	.hero h2 {
		font-size: 2rem;
		line-height: 1.1;
		margin-bottom: 1.5rem;
		color: var(--white);
	}

	.hero p {
		font-size: 1.2rem;
		color: rgba(255, 255, 255, 0.9);
		margin-bottom: 3rem;
		max-width: 600px;
		margin-inline: auto;
	}

	.search-box {
		background: var(--white);
		padding: 2rem 2.5rem;
		border-radius: 4px;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
		max-width: 420px;
		margin: 0 auto;
		border: 1px solid rgba(0, 0, 0, 0.05);
		text-align: center;
	}

	.search-box .search-label {
		color: #555;
		font-size: 0.95rem;
		font-weight: 500;
		margin-bottom: 1.5rem;
	}

	.search-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
	}

	.btn-option {
		flex: 1;
		padding: 0.9rem 2rem;
		font-family: inherit;
		font-weight: 600;
		font-size: 1rem;
		text-align: center;
		border: 2px solid var(--primary);
		background: transparent;
		color: var(--primary);
		cursor: pointer;
		transition: all 0.3s;
		text-decoration: none;
	}

	.btn-option:hover {
		background: var(--primary);
		color: var(--white);
	}

	.btn-primary {
		background: var(--primary);
		color: var(--white);
		padding: 0.8rem 2rem;
		border: none;
		cursor: pointer;
		font-weight: 600;
		transition: background 0.3s;
	}

	.btn-primary:hover {
		background: #333;
	}

	.featured {
		padding: 8rem 2rem;
	}

	.section-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.section-header h2 {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}

	.property-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(350px, 100%), 1fr));
		gap: 2.5rem;
	}

	.cta {
		background: var(--secondary);
		padding: 6rem 0;
		text-align: center;
	}

	.cta h2 {
		font-size: 2.5rem;
		margin-bottom: 1.5rem;
	}

	.cta p {
		max-width: 600px;
		margin: 0 auto 2.5rem;
		color: var(--text-muted);
	}

	.footer {
		padding: 5rem 0 2rem;
		background: #fff;
		border-top: 1px solid #eee;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 4rem;
		margin-bottom: 4rem;
	}

	.footer-brand p {
		margin-top: 1.5rem;
		color: var(--text-muted);
		max-width: 300px;
	}

	.footer h4 {
		margin-bottom: 1.5rem;
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.footer-links a {
		display: block;
		margin-bottom: 0.8rem;
		color: var(--text-muted);
	}

	.footer-links a:hover {
		color: var(--accent);
	}

	.footer-contact p {
		color: var(--text-muted);
		margin-bottom: 0.8rem;
	}

	.footer-bottom {
		text-align: center;
		padding-top: 2rem;
		border-top: 1px solid #eee;
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	/* Hamburger button */
	.hamburger {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5rem;
		z-index: 201;
	}

	.hamburger span {
		display: block;
		width: 24px;
		height: 2px;
		background: var(--white);
		transition: all 0.3s ease;
	}

	.header.scrolled .hamburger span {
		background: var(--primary);
	}

	.hamburger.active span:nth-child(1) {
		transform: rotate(45deg) translate(5px, 5px);
	}

	.hamburger.active span:nth-child(2) {
		opacity: 0;
	}

	.hamburger.active span:nth-child(3) {
		transform: rotate(-45deg) translate(5px, -5px);
	}

	@media (max-width: 768px) {
		.hamburger {
			display: flex;
		}

		.nav {
			display: none;
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100vh;
			background: rgba(0, 0, 0, 0.95);
			flex-direction: column;
			justify-content: center;
			align-items: center;
			gap: 2rem;
			z-index: 200;
			font-size: 1.2rem;
		}

		.nav.active {
			display: flex;
		}

		.nav a {
			color: var(--white) !important;
			font-size: 1.2rem;
		}

		.nav .btn-outline {
			border-color: var(--white);
		}

		.hero h1 {
			font-size: 2.5rem;
		}

		.hero h2 {
			font-size: 1.5rem;
		}

		.hero p {
			font-size: 1rem;
		}

		.search-fields {
			flex-direction: column;
		}
		.footer-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.hero-content {
			max-width: 100%;
		}
		.hero p {
			margin-inline: auto;
		}
		.search-box {
			margin-inline: auto;
		}
	}
</style>
