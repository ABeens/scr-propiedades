---
import Layout from '../layouts/Layout.astro';
import { properties } from '../data/properties';

const base = import.meta.env.BASE_URL;
const featured = properties.slice(0, 3);
const publishWhatsAppMessage = encodeURIComponent("Hola, me interesa publicar mi propiedad con ustedes.");
const publishWhatsAppLink = `https://wa.me/50670141868?text=${publishWhatsAppMessage}`;
---

<Layout showWhatsApp={true}>
	<header class="header">
		<div class="container nav-wrapper">
			<div class="logo">
				<img src={`${base}/main-logo-dark-mode.png`} alt="Main Logo" height="80" />
			</div>
			<button class="hamburger" id="hamburgerBtn" aria-label="Abrir menú">
				<span></span>
				<span></span>
				<span></span>
			</button>
			<nav class="nav" id="mainNav">
				<a href="#inicio">Inicio</a>
				<a href={`${base}/catalog?type=sale`}>Comprar</a>
				<a href={`${base}/catalog?type=rent`}>Alquilar</a>
				<a href="#contacto" class="btn-outline">Contacto</a>
			</nav>
		</div>
	</header>

	<main>
		<section class="hero" id="inicio">
			<div class="video-background">
				<video autoplay muted loop playsinline poster={`${base}/bg-min.png`}>
					<source src={`${base}/bg-video.mp4`} type="video/mp4" />
					Tu navegador no soporta videos.
				</video>
			</div>
			<div class="container">
				<div class="hero-content">
					<h2>Asesoría inmobiliaria adaptada a sus necesidades.</h2>
					<p>Orientación profesional para decisiones importantes.</p>
					
					<div class="search-box">
						<p class="search-label">¿Qué deseas hacer? Nosotros te ayudamos</p>
						<div class="search-buttons">
							<a href={`${base}/catalog?type=sale`} class="btn-option">Comprar</a>
							<a href={`${base}/catalog?type=rent`} class="btn-option">Alquilar</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="featured container" id="venta">
			<div class="section-header">
				<h2>Propiedades Destacadas</h2>
			</div>

			<div class="property-grid">
				{featured.map(prop => (
					<a href={`${base}/propiedad/${prop.id}`} class="property-card">
						<div class="card-image">
							<img src={prop.images[0]} alt={prop.title} />
							<span class="badge">{prop.type === 'sale' ? 'Comprar' : 'Alquilar'}</span>
						</div>
						<div class="card-info">
							<h3 class="card-title">{prop.title}</h3>
							<p class="location">
								<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
								{prop.location}
							</p>
							<p class="price">{prop.priceDisplay} | <span class="price-usd">{prop.priceDisplayUSD}</span></p>
							
							<div class="card-specs">
								<div class="spec-main-row">
									<span class="spec-label">{prop.propertyType}</span>
									<span class="status-tag">{prop.status}</span>
								</div>
								<div class="spec-icons-row">
									{prop.beds > 0 && (
										<div class="spec-pill" title="Habitaciones">
											<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v11m0-4h18m0 4V8a3 3 0 0 0-3-3H6a3 3 0 0 0-3 3"/><path d="M7 11V7"/><path d="M17 11V7"/></svg>
											<span>{prop.beds}</span>
										</div>
									)}
									{prop.baths > 0 && (
										<div class="spec-pill" title="Baños">
											<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16a1 1 0 0 1 1 1v3a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4v-3a1 1 0 0 1 1-1z"/><path d="M6 12V5a2 2 0 0 1 2-2h3v2.25"/></svg>
											<span>{prop.baths}</span>
										</div>
									)}
									<div class="spec-pill" title="Área">
										<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 12h18"/><path d="M12 3v18"/></svg>
										<span>{prop.area.replace(' m²', '')}m²</span>
									</div>
									{prop.parking > 0 && (
										<div class="spec-pill" title="Parqueos">
											<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/></svg>
											<span>{prop.parking}</span>
										</div>
									)}
								</div>
							</div>
						</div>
					</a>
				))}
			</div>
		</section>

		<section class="cta">
			<div class="container">
				<h2>¿Listo para vender tu propiedad?</h2>
				<p>Permítenos ayudarte a encontrar al comprador ideal con nuestra red exclusiva.</p>
				<a href={publishWhatsAppLink} target="_blank" rel="noopener noreferrer" class="btn-primary">Contáctanos Hoy</a>
			</div>
		</section>
	</main>

	<footer class="footer">
		<div class="container footer-grid">
			<div class="footer-brand">
				<img src={`${base}/main-logo.png`} alt="Logo" height="40" />
				<p>Excelencia en servicios inmobiliarios.</p>
			</div>
			<div class="footer-links">
				<h4>Navegación</h4>
				<a href={`${base}/catalog?type=sale`}>Comprar</a>
				<a href={`${base}/catalog?type=rent`}>Alquilar</a>
				<a href={base}>Nosotros</a>
			</div>
			<div class="footer-contact" id="contacto">
				<h4>Contacto</h4>
				<p>San José, Costa Rica</p>
				<p>+506 7014 1868</p>
			</div>
		</div>
		<div class="footer-bottom">
			<p>&copy; 2024 Real Estate. Todos los derechos reservados.</p>
		</div>
	</footer>
</Layout>

<script data-base={base} is:inline>
	const scriptTag = document.querySelector('script[data-base]');
	const basePath = scriptTag?.getAttribute('data-base') || '/';
	const header = document.querySelector('.header');
	window.addEventListener('scroll', () => {
		if (window.scrollY > 50) {
			header.classList.add('scrolled');
			const logo = document.querySelector('.logo img');
			logo.src = basePath + '/main-logo.png';
		} else {
			header.classList.remove('scrolled');
			const logo = document.querySelector('.logo img');
			logo.src = basePath + '/main-logo-dark-mode.png';
		}
	});

	// Hamburger menu
	const hamburgerBtn = document.getElementById('hamburgerBtn');
	const mainNav = document.getElementById('mainNav');

	hamburgerBtn.addEventListener('click', () => {
		hamburgerBtn.classList.toggle('active');
		mainNav.classList.toggle('active');
		document.body.style.overflow = mainNav.classList.contains('active') ? 'hidden' : '';
	});

	mainNav.querySelectorAll('a').forEach(link => {
		link.addEventListener('click', () => {
			hamburgerBtn.classList.remove('active');
			mainNav.classList.remove('active');
			document.body.style.overflow = '';
		});
	});
</script>

<style>
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.header {
		position: fixed;
		top: 0;
		width: 100%;
		z-index: 100;
		padding: 1.5rem 0;
		background: transparent;
		transition: background 0.3s ease;
	}

	.header.scrolled {
		background: rgba(255, 255, 255, 0.95);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(0,0,0,0.05);
	}

	.nav-wrapper {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.nav {
		display: flex;
		gap: 2.5rem;
		align-items: center;
		font-weight: 500;
		text-transform: uppercase;
		font-size: 0.85rem;
		letter-spacing: 1px;
		color: var(--white);
	}

	.nav a:hover {
		color: var(--accent);
	}

	.btn-outline {
		padding: 0.6rem 1.5rem;
		border: 1px solid var(--white);
		color: var(--white) !important;
		transition: all 0.3s;
	}

	.btn-outline:hover {
		background: var(--primary);
		color: var(--white) !important;
	}

	.header.scrolled .nav {
		color: var(--primary);
	}

	.header.scrolled .btn-outline {
		border-color: var(--primary);
		color: var(--primary) !important;
	}

	.header.scrolled .btn-outline:hover {
		background: var(--primary);
		color: var(--white) !important;
	}

	.hero {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		position: relative;
		overflow: hidden;
	}

	.video-background {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		pointer-events: none;
	}

	.video-background video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		position: absolute;
		top: 0;
		left: 0;
	}

	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.5);
		z-index: 1;
	}

	.hero .container {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.hero-content {
		z-index: 2;
	}

	.hero h1 {
		font-size: 4rem;
		line-height: 1.1;
		margin-bottom: 1.5rem;
		color: var(--white);
	}

		.hero h2 {
		font-size: 3rem;
		line-height: 1.1;
		margin-bottom: 1.5rem;
		color: var(--white);
	}

	.hero p {
		font-size: 1.2rem;
		color: rgba(255, 255, 255, 0.9);
		margin-bottom: 3rem;
		max-width: 600px;
		margin-inline: auto;
	}



	.search-box {
		background: var(--white);
		padding: 2rem 2.5rem;
		border-radius: 4px;
		box-shadow: 0 10px 30px rgba(0,0,0,0.08);
		max-width: 420px;
		margin: 0 auto;
		border: 1px solid rgba(0,0,0,0.05);
		text-align: center;
	}

	.search-box .search-label {
		color: #555;
		font-size: 0.95rem;
		font-weight: 500;
		margin-bottom: 1.5rem;
	}

	.search-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
	}

	.btn-option {
		flex: 1;
		padding: 0.9rem 2rem;
		font-family: inherit;
		font-weight: 600;
		font-size: 1rem;
		text-align: center;
		border: 2px solid var(--primary);
		background: transparent;
		color: var(--primary);
		cursor: pointer;
		transition: all 0.3s;
		text-decoration: none;
	}

	.btn-option:hover {
		background: var(--primary);
		color: var(--white);
	}

	.btn-primary {
		background: var(--primary);
		color: var(--white);
		padding: 0.8rem 2rem;
		border: none;
		cursor: pointer;
		font-weight: 600;
		transition: background 0.3s;
	}

	.btn-primary:hover {
		background: #333;
	}

	.featured {
		padding: 8rem 2rem;
	}

	.section-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.section-header h2 {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}

	.property-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 2.5rem;
	}

	.property-card {
		background: #fff;
		border: 1px solid #eee;
		overflow: hidden;
		transition: transform 0.3s;
		color: inherit !important;
		display: block;
	}

	.property-card:hover {
		transform: translateY(-10px);
	}

	.card-image {
		position: relative;
		height: 250px;
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.badge {
		position: absolute;
		top: 1rem;
		right: 1rem;
		background: var(--accent);
		color: #fff;
		padding: 0.3rem 0.8rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.5px;
	}

	.card-info {
		padding: 1.5rem;
	}

	.card-info h3 {
		font-size: 1.3rem;
		margin-bottom: 0.5rem;
	}

	.location {
		color: var(--text-muted);
		font-size: 0.85rem;
		margin-bottom: 1rem;
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.location svg {
		color: var(--accent);
		flex-shrink: 0;
	}

	.price {
		font-weight: 700;
		color: var(--primary);
		font-size: 1.15rem;
		margin-bottom: 1.5rem;
	}

	.price-usd {
		color: var(--text-muted);
		font-weight: 500;
	}

	.card-specs {
		margin-bottom: 0;
		border-top: 1px solid #eee;
		padding-top: 1rem;
	}

	.spec-main-row {
		margin-bottom: 0.8rem;
		display: flex;
		justify-content: flex-start;
		gap: 0.8rem;
		align-items: center;
	}

	.spec-icons-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
	}

	.spec-pill {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.85rem;
		color: var(--text-muted);
		background: #f8f8f8;
		padding: 0.3rem 0.6rem;
		border-radius: 4px;
		border: 1px solid #eee;
	}

	.spec-pill svg {
		color: var(--accent);
		flex-shrink: 0;
	}

	.spec-label {
		font-weight: 700;
		color: var(--primary);
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.status-tag {
		font-size: 0.65rem;
		background: #fcf8f1;
		color: #a17d3a;
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		border: 1px solid #e5d5b5;
	}

	.cta {
		background: var(--secondary);
		padding: 6rem 0;
		text-align: center;
	}

	.cta h2 {
		font-size: 2.5rem;
		margin-bottom: 1.5rem;
	}

	.cta p {
		max-width: 600px;
		margin: 0 auto 2.5rem;
		color: var(--text-muted);
	}

	.footer {
		padding: 5rem 0 2rem;
		background: #fff;
		border-top: 1px solid #eee;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 4rem;
		margin-bottom: 4rem;
	}

	.footer-brand p {
		margin-top: 1.5rem;
		color: var(--text-muted);
		max-width: 300px;
	}

	.footer h4 {
		margin-bottom: 1.5rem;
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.footer-links a {
		display: block;
		margin-bottom: 0.8rem;
		color: var(--text-muted);
	}

	.footer-links a:hover {
		color: var(--accent);
	}

	.footer-contact p {
		color: var(--text-muted);
		margin-bottom: 0.8rem;
	}

	.footer-bottom {
		text-align: center;
		padding-top: 2rem;
		border-top: 1px solid #eee;
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	/* Hamburger button */
	.hamburger {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5rem;
		z-index: 201;
	}

	.hamburger span {
		display: block;
		width: 24px;
		height: 2px;
		background: var(--white);
		transition: all 0.3s ease;
	}

	.header.scrolled .hamburger span {
		background: var(--primary);
	}

	.hamburger.active span:nth-child(1) {
		transform: rotate(45deg) translate(5px, 5px);
	}

	.hamburger.active span:nth-child(2) {
		opacity: 0;
	}

	.hamburger.active span:nth-child(3) {
		transform: rotate(-45deg) translate(5px, -5px);
	}

	@media (max-width: 768px) {
		.hamburger {
			display: flex;
		}

		.nav {
			display: none;
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100vh;
			background: rgba(0, 0, 0, 0.95);
			flex-direction: column;
			justify-content: center;
			align-items: center;
			gap: 2rem;
			z-index: 200;
			font-size: 1.2rem;
		}

		.nav.active {
			display: flex;
		}

		.nav a {
			color: var(--white) !important;
			font-size: 1.2rem;
		}

		.nav .btn-outline {
			border-color: var(--white);
		}

		.hero h1 {
			font-size: 2.5rem;
		}
		.search-fields {
			flex-direction: column;
		}
		.footer-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.hero-content {
			max-width: 100%;
		}
		.hero p {
			margin-inline: auto;
		}
		.search-box {
			margin-inline: auto;
		}
	}
</style>
