---
import Layout from '../layouts/Layout.astro';
import { properties } from '../data/properties';

const base = import.meta.env.BASE_URL;
const featured = properties.slice(0, 3);
---

<Layout>
	<header class="header">
		<div class="container nav-wrapper">
			<div class="logo">
				<img src={`${base}/main-logo-dark-mode.png`} alt="Main Logo" height="50" />
			</div>
			<button class="hamburger" id="hamburgerBtn" aria-label="Abrir menú">
				<span></span>
				<span></span>
				<span></span>
			</button>
			<nav class="nav" id="mainNav">
				<a href="#inicio">Inicio</a>
				<a href={`${base}/catalogo?type=Venta`}>Venta</a>
				<a href={`${base}/catalogo?type=Renta`}>Renta</a>
				<a href="#contacto" class="btn-outline">Contacto</a>
			</nav>
		</div>
	</header>

	<main>
		<section class="hero" id="inicio">
			<div class="video-background">
				<video autoplay muted loop playsinline poster={`${base}/bg-min.png`}>
					<source src={`${base}/bg-video.mp4`} type="video/mp4" />
					Tu navegador no soporta videos.
				</video>
			</div>
			<div class="container">
				<div class="hero-content">
					<h1>Encuentra tu próximo <br/>capítulo aquí.</h1>
					<p>Propiedades exclusivas seleccionadas para quienes buscan lo extraordinario.</p>
					
					<div class="search-box">
						<p class="search-label">¿Qué deseas hacer? Nosotros te ayudamos</p>
						<div class="search-buttons">
							<a href={`${base}/catalogo?type=Venta`} class="btn-option">Comprar</a>
							<a href={`${base}/catalogo?type=Renta`} class="btn-option">Rentar</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="featured container" id="venta">
			<div class="section-header">
				<h2>Propiedades Destacadas</h2>
				<p>Descubre nuestra selección de inmuebles de lujo.</p>
			</div>

			<div class="property-grid">
				{featured.map(prop => (
					<div class="property-card">
						<div class="card-image">
							<img src={prop.images[0]} alt={prop.title} />
							<span class="badge">{prop.type}</span>
						</div>
						<div class="card-info">
							<h3>{prop.title}</h3>
							<p class="location">{prop.location}</p>
							<p class="price">{prop.priceDisplay}</p>
							<div class="specs">
								<span>{prop.beds} Hab</span>
								<span>{prop.baths} Baños</span>
							</div>
						</div>
					</div>
				))}
			</div>
		</section>

		<section class="cta">
			<div class="container">
				<h2>¿Listo para vender tu propiedad?</h2>
				<p>Permítenos ayudarte a encontrar al comprador ideal con nuestra red exclusiva.</p>
				<a href="mailto:info@example.com" class="btn-primary">Contáctanos Hoy</a>
			</div>
		</section>
	</main>

	<footer class="footer">
		<div class="container footer-grid">
			<div class="footer-brand">
				<img src={`${base}/main-logo.png`} alt="Logo" height="40" />
				<p>Excelencia en servicios inmobiliarios.</p>
			</div>
			<div class="footer-links">
				<h4>Navegación</h4>
				<a href={`${base}/catalogo?type=Venta`}>Venta</a>
				<a href={`${base}/catalogo?type=Renta`}>Renta</a>
				<a href={base}>Nosotros</a>
			</div>
			<div class="footer-contact" id="contacto">
				<h4>Contacto</h4>
				<p>San José, Costa Rica</p>
				<p>+506 7014 1868</p>
			</div>
		</div>
		<div class="footer-bottom">
			<p>&copy; 2024 Real Estate. Todos los derechos reservados.</p>
		</div>
	</footer>
</Layout>

<script data-base={base} is:inline>
	const scriptTag = document.querySelector('script[data-base]');
	const basePath = scriptTag?.getAttribute('data-base') || '/';
	const header = document.querySelector('.header');
	window.addEventListener('scroll', () => {
		if (window.scrollY > 50) {
			header.classList.add('scrolled');
			const logo = document.querySelector('.logo img');
			logo.src = basePath + '/main-logo.png';
		} else {
			header.classList.remove('scrolled');
			const logo = document.querySelector('.logo img');
			logo.src = basePath + '/main-logo-dark-mode.png';
		}
	});

	// Hamburger menu
	const hamburgerBtn = document.getElementById('hamburgerBtn');
	const mainNav = document.getElementById('mainNav');

	hamburgerBtn.addEventListener('click', () => {
		hamburgerBtn.classList.toggle('active');
		mainNav.classList.toggle('active');
		document.body.style.overflow = mainNav.classList.contains('active') ? 'hidden' : '';
	});

	mainNav.querySelectorAll('a').forEach(link => {
		link.addEventListener('click', () => {
			hamburgerBtn.classList.remove('active');
			mainNav.classList.remove('active');
			document.body.style.overflow = '';
		});
	});
</script>

<style>
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.header {
		position: fixed;
		top: 0;
		width: 100%;
		z-index: 100;
		padding: 1.5rem 0;
		background: transparent;
		transition: background 0.3s ease;
	}

	.header.scrolled {
		background: rgba(255, 255, 255, 0.95);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(0,0,0,0.05);
	}

	.nav-wrapper {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.nav {
		display: flex;
		gap: 2.5rem;
		align-items: center;
		font-weight: 500;
		text-transform: uppercase;
		font-size: 0.85rem;
		letter-spacing: 1px;
		color: var(--white);
	}

	.nav a:hover {
		color: var(--accent);
	}

	.btn-outline {
		padding: 0.6rem 1.5rem;
		border: 1px solid var(--white);
		color: var(--white) !important;
		transition: all 0.3s;
	}

	.btn-outline:hover {
		background: var(--primary);
		color: var(--white) !important;
	}

	.header.scrolled .nav {
		color: var(--primary);
	}

	.header.scrolled .btn-outline {
		border-color: var(--primary);
		color: var(--primary) !important;
	}

	.header.scrolled .btn-outline:hover {
		background: var(--primary);
		color: var(--white) !important;
	}

	.hero {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		position: relative;
		overflow: hidden;
	}

	.video-background {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		pointer-events: none;
	}

	.video-background video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		position: absolute;
		top: 0;
		left: 0;
	}

	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.5);
		z-index: 1;
	}

	.hero .container {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.hero-content {
		z-index: 2;
	}

	.hero h1 {
		font-size: 4rem;
		line-height: 1.1;
		margin-bottom: 1.5rem;
		color: var(--white);
	}

	.hero p {
		font-size: 1.2rem;
		color: rgba(255, 255, 255, 0.9);
		margin-bottom: 3rem;
		max-width: 600px;
	}



	.search-box {
		background: var(--white);
		padding: 2rem 2.5rem;
		border-radius: 4px;
		box-shadow: 0 10px 30px rgba(0,0,0,0.08);
		max-width: 420px;
		margin: 0 auto;
		border: 1px solid rgba(0,0,0,0.05);
		text-align: center;
	}

	.search-box .search-label {
		color: #555;
		font-size: 0.95rem;
		font-weight: 500;
		margin-bottom: 1.5rem;
	}

	.search-buttons {
		display: flex;
		gap: 1rem;
		justify-content: center;
	}

	.btn-option {
		flex: 1;
		padding: 0.9rem 2rem;
		font-family: inherit;
		font-weight: 600;
		font-size: 1rem;
		text-align: center;
		border: 2px solid var(--primary);
		background: transparent;
		color: var(--primary);
		cursor: pointer;
		transition: all 0.3s;
		text-decoration: none;
	}

	.btn-option:hover {
		background: var(--primary);
		color: var(--white);
	}

	.btn-primary {
		background: var(--primary);
		color: var(--white);
		padding: 0.8rem 2rem;
		border: none;
		cursor: pointer;
		font-weight: 600;
		transition: background 0.3s;
	}

	.btn-primary:hover {
		background: #333;
	}

	.featured {
		padding: 8rem 2rem;
	}

	.section-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.section-header h2 {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}

	.property-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 2.5rem;
	}

	.property-card {
		background: #fff;
		border: 1px solid #eee;
		overflow: hidden;
		transition: transform 0.3s;
	}

	.property-card:hover {
		transform: translateY(-10px);
	}

	.card-image {
		position: relative;
		height: 250px;
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.badge {
		position: absolute;
		top: 1rem;
		right: 1rem;
		background: var(--accent);
		color: #fff;
		padding: 0.3rem 0.8rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.5px;
	}

	.card-info {
		padding: 1.5rem;
	}

	.card-info h3 {
		font-size: 1.3rem;
		margin-bottom: 0.5rem;
	}

	.location {
		color: var(--text-muted);
		font-size: 0.9rem;
		margin-bottom: 1rem;
	}

	.price {
		font-weight: 700;
		color: var(--primary);
		font-size: 1.2rem;
		margin-bottom: 1rem;
	}

	.specs {
		display: flex;
		gap: 1.5rem;
		font-size: 0.85rem;
		border-top: 1px solid #eee;
		padding-top: 1rem;
		color: var(--text-muted);
	}

	.cta {
		background: var(--secondary);
		padding: 6rem 0;
		text-align: center;
	}

	.cta h2 {
		font-size: 2.5rem;
		margin-bottom: 1.5rem;
	}

	.cta p {
		max-width: 600px;
		margin: 0 auto 2.5rem;
		color: var(--text-muted);
	}

	.footer {
		padding: 5rem 0 2rem;
		background: #fff;
		border-top: 1px solid #eee;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 4rem;
		margin-bottom: 4rem;
	}

	.footer-brand p {
		margin-top: 1.5rem;
		color: var(--text-muted);
		max-width: 300px;
	}

	.footer h4 {
		margin-bottom: 1.5rem;
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.footer-links a {
		display: block;
		margin-bottom: 0.8rem;
		color: var(--text-muted);
	}

	.footer-links a:hover {
		color: var(--accent);
	}

	.footer-contact p {
		color: var(--text-muted);
		margin-bottom: 0.8rem;
	}

	.footer-bottom {
		text-align: center;
		padding-top: 2rem;
		border-top: 1px solid #eee;
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	/* Hamburger button */
	.hamburger {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5rem;
		z-index: 201;
	}

	.hamburger span {
		display: block;
		width: 24px;
		height: 2px;
		background: var(--white);
		transition: all 0.3s ease;
	}

	.header.scrolled .hamburger span {
		background: var(--primary);
	}

	.hamburger.active span:nth-child(1) {
		transform: rotate(45deg) translate(5px, 5px);
	}

	.hamburger.active span:nth-child(2) {
		opacity: 0;
	}

	.hamburger.active span:nth-child(3) {
		transform: rotate(-45deg) translate(5px, -5px);
	}

	@media (max-width: 768px) {
		.hamburger {
			display: flex;
		}

		.nav {
			display: none;
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100vh;
			background: rgba(0, 0, 0, 0.95);
			flex-direction: column;
			justify-content: center;
			align-items: center;
			gap: 2rem;
			z-index: 200;
			font-size: 1.2rem;
		}

		.nav.active {
			display: flex;
		}

		.nav a {
			color: var(--white) !important;
			font-size: 1.2rem;
		}

		.nav .btn-outline {
			border-color: var(--white);
		}

		.hero h1 {
			font-size: 2.5rem;
		}
		.search-fields {
			flex-direction: column;
		}
		.footer-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.hero-content {
			max-width: 100%;
		}
		.hero p {
			margin-inline: auto;
		}
		.search-box {
			margin-inline: auto;
		}
	}
</style>
