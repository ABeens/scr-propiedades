---
interface Props {
	id: string;
	title: string;
	type: string;
	location: string;
	provinciaId: string;
	cantonId: string;
	distritoId: string;
	beds: number;
	baths: number;
	parking: number;
	area: string;
	price: number;
	priceUSD: number;
	priceDisplay: string;
	priceDisplayUSD: string;
	propertyType: string;
	status: string;
	image: string;
}

const {
	id, title, type, location,
	provinciaId, cantonId, distritoId,
	beds, baths, parking, area,
	price, priceUSD, priceDisplay, priceDisplayUSD,
	propertyType, status, image,
} = Astro.props;

const statusLabels: Record<string, string> = {
	available: 'Disponible',
	presale: 'Preventa',
	investment: 'Inversión',
	sold: 'Vendido',
	rented: 'Alquilado',
};
const statusLabel = statusLabels[status] || status;
---

<a href={`/propiedad/${id}`}
	 class="property-card"
	 data-type={type}
	 data-provincia={provinciaId}
	 data-canton={cantonId}
	 data-distrito={distritoId}
	 data-beds={beds}
	 data-baths={baths}
	 data-parking={parking}
	 data-area-val={area.replace(/[^\d.]/g, '')}
	 data-price={price}
	 data-price-usd={priceUSD}
	 data-property-type={propertyType}
	 data-status={status}
>
	<div class="card-image">
		<img src={image} alt={title} loading="lazy" />
		<span class="badge">{type === 'sale' ? 'Comprar' : 'Alquilar'}</span>
	</div>
	<div class="card-info">
		<h3 class="card-title">{title}</h3>
		<p class="location">
			<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
			{location}
		</p>
		{(priceDisplay || priceDisplayUSD) && (
			<p class="price">
				{priceDisplay}{priceDisplay && priceDisplayUSD && ' | '}<span class="price-usd">{priceDisplayUSD}</span>
			</p>
		)}

		<div class="card-specs">
			<div class="spec-main-row">
				<span class="spec-label">{propertyType}</span>
				<span class="status-tag">{statusLabel}</span>
			</div>
			<div class="spec-icons-row">
				{beds > 0 && (
					<div class="spec-pill" title="Habitaciones">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v11m0-4h18m0 4V8a3 3 0 0 0-3-3H6a3 3 0 0 0-3 3"/><path d="M7 11V7"/><path d="M17 11V7"/></svg>
						<span>{beds}</span>
					</div>
				)}
				{baths > 0 && (
					<div class="spec-pill" title="Baños">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16a1 1 0 0 1 1 1v3a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4v-3a1 1 0 0 1 1-1z"/><path d="M6 12V5a2 2 0 0 1 2-2h3v2.25"/></svg>
						<span>{baths}</span>
					</div>
				)}
				<div class="spec-pill" title="Área">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 12h18"/><path d="M12 3v18"/></svg>
					<span>{area.replace(' m²', '')}m²</span>
				</div>
				{parking > 0 && (
					<div class="spec-pill" title="Parqueos">
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 17V7h4a3 3 0 0 1 0 6H9"/></svg>
						<span>{parking}</span>
					</div>
				)}
			</div>
		</div>
	</div>
</a>

<style>
	.property-card {
		background: #fff;
		border: 1px solid #eee;
		border-radius: 8px;
		overflow: hidden;
		transition: transform 0.3s, box-shadow 0.3s;
		color: inherit !important;
		display: block;
	}

	.property-card:hover {
		transform: translateY(-5px);
		box-shadow: 0 10px 20px rgba(0,0,0,0.05);
	}

	.card-image {
		height: 220px;
		position: relative;
		overflow: hidden;
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s;
	}

	.property-card:hover .card-image img {
		transform: scale(1.05);
	}

	.badge {
		position: absolute;
		top: 1rem;
		right: 1rem;
		background: var(--accent);
		color: #fff;
		padding: 0.3rem 0.8rem;
		font-size: 0.75rem;
		font-weight: 600;
		border-radius: 2px;
	}

	.card-info {
		padding: 1.5rem;
	}

	.card-info h3 {
		font-size: 1.2rem;
		margin-bottom: 0.5rem;
		line-height: 1.3;
	}

	.location {
		color: var(--text-muted);
		font-size: 0.85rem;
		margin-bottom: 1rem;
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.location svg {
		color: var(--accent);
		flex-shrink: 0;
	}

	.price {
		color: var(--primary);
		font-weight: 700;
		font-size: 1.05rem;
		margin-bottom: 1.5rem;
	}

	.price-usd {
		color: var(--primary);
		font-weight: 700;
	}

	.card-specs {
		border-top: 1px solid #f0f0f0;
		padding-top: 1rem;
	}

	.spec-main-row {
		margin-bottom: 0.8rem;
		display: flex;
		justify-content: flex-start;
		gap: 0.8rem;
		align-items: center;
	}

	.spec-icons-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: flex-start;
	}

	.spec-pill {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.75rem;
		color: var(--text-muted);
		background: #f8f8f8;
		padding: 0.2rem 0.45rem;
		border-radius: 4px;
		border: 1px solid #eee;
	}

	.spec-pill svg {
		color: var(--accent);
		flex-shrink: 0;
	}

	.spec-label {
		font-weight: 700;
		color: var(--primary);
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.status-tag {
		font-size: 0.65rem;
		background: #fcf8f1;
		color: var(--accent);
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		border: 1px solid #e5d5b5;
	}
</style>
