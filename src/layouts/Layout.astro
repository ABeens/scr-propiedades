---
interface Props {
	title?: string;
	description?: string;
	image?: string;
	showWhatsApp?: boolean;
	whatsAppNumber?: string;
	whatsAppMessage?: string;
}

const {
	title = "SCR Propiedades - Asesoría Inmobiliaria en Costa Rica",
	description = "Asesoría inmobiliaria profesional en Costa Rica. Casas, apartamentos, lotes, fincas y locales comerciales en venta y alquiler.",
	image,
	showWhatsApp = false,
	whatsAppNumber = "50670141868",
	whatsAppMessage = "Hola, me interesa más información sobre sus propiedades."
} = Astro.props;

const canonicalURL = Astro.url.href;
const ogImage = image || `${Astro.url.origin}/main-logo.png`;
const whatsAppLink = `https://wa.me/${whatsAppNumber}?text=${encodeURIComponent(whatsAppMessage)}`;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href={`/favicon.svg`} />
		<link rel="icon" type="image/x-icon" href={`/favicon.ico`} />
		<link rel="apple-touch-icon" href={`/main-logo.png`} />

		<!-- SEO -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content="es_CR" />
		<meta property="og:site_name" content="SCR Propiedades" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Theme -->
		<meta name="theme-color" content="#1a1a1a" />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
	</head>
	<body>
		<slot />

		{showWhatsApp && (
			<a href={whatsAppLink} target="_blank" rel="noopener noreferrer" class="whatsapp-float" aria-label="Contactar por WhatsApp">
				<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="#fff"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
			</a>
		)}
	</body>
</html>

<style is:global>
	:root {
		--primary: #1a1a1a;
		--secondary: #f5f5f5;
		--accent: #c5a059; /* Gold/Luxury accent */
		--text-main: #333333;
		--text-muted: #666666;
		--white: #ffffff;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html,
	body {
		font-family: 'Inter', system-ui, -apple-system, sans-serif;
		color: var(--text-main);
		background-color: var(--white);
		line-height: 1.6;
		overflow-x: hidden;
	}

	h1, h2, h3 {
		font-family: 'Playfair Display', serif;
		color: var(--primary);
	}

	a {
		text-decoration: none;
		color: inherit;
		transition: all 0.3s ease;
	}

	ul {
		list-style: none;
	}

	/* WhatsApp Float */
	.whatsapp-float {
		position: fixed;
		bottom: 2rem;
		right: 2rem;
		width: 60px;
		height: 60px;
		background: #25D366;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4px 16px rgba(0,0,0,0.2);
		z-index: 1000;
		transition: all 0.3s;
	}

	.whatsapp-float:hover {
		transform: scale(1.1);
		box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4);
	}

	@media (max-width: 850px) {
		.whatsapp-float {
			width: 50px;
			height: 50px;
			bottom: 1.5rem;
			right: 1.5rem;
		}
	}
</style>
