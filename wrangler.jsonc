{
	"main": "dist/_worker.js/index.js",
	"name": "scr-propiedades",
	"compatibility_date": "2026-02-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "scr-propiedades-db",
			"database_id": "placeholder-replace-after-creation"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES_BUCKET",
			"bucket_name": "scr-propiedades-images"
		}
	]
}
