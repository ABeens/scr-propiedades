{
	"name": "scr-propiedades",
	"pages_build_output_dir": "./dist",
	"compatibility_date": "2024-12-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "scr-propiedades-db",
			"database_id": "daf79163-03ec-428b-acde-00ff607b201d"
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES_BUCKET",
			"bucket_name": "scr-propiedades-images"
		}
	]
}